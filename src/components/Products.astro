---
import { Image } from 'astro:assets'
import { productsFor } from '../data/products'
import { langFromUrl } from '../i18n'
import { demoLink } from '../lib/contact'
import { productIcons } from '../data/product-icons'
import EnergyDashboard from './EnergyDashboard.astro'
import EquipmentDashboard from './EquipmentDashboard.astro'
import PlantationDashboard from './PlantationDashboard.astro'
import VisionDashboard from './VisionDashboard.astro'
import CustomDashboard from './CustomDashboard.astro'

const icons = productIcons
const lang = langFromUrl(Astro.url)
const products = productsFor(lang)
const t = {
  en: { title: 'Products proven in the field, ready to deploy', lede: 'Each product is based on a system already running at a client site.', tabs: 'Products', demo: 'Request a demo', shot: 'dashboard' },
  id: { title: 'Produk yang sudah terbukti di lapangan, siap diterapkan', lede: 'Setiap produk berasal dari sistem yang sudah berjalan di lokasi klien.', tabs: 'Produk', demo: 'Minta demo', shot: 'dashboard' },
}[lang]

/** Same polyline maths as the draft, run at build time instead of in the browser. */
function sparkPoints(values: number[]) {
  const w = 300
  const h = 110
  const max = 70
  const step = w / (values.length - 1)
  return values
    .map((y, i) => `${(i * step).toFixed(1)},${(h - (y / max) * h * 0.9).toFixed(1)}`)
    .join(' ')
}
---

<section id="products">
  <div class="wrap">
    <h2>{t.title}</h2>
    <p class="lede">{t.lede}</p>

    {/* scroll targets for the navbar's #product-<key> links */}
    {products.map((p) => <span class="tab-anchor" id={`product-${p.key}`} aria-hidden="true" />)}
    <div class="tabs">
      <div class="tablist" role="tablist" aria-label={t.tabs} id="tablist">
        {
          products.map((p, i) => (
            <button
              type="button"
              class="tab"
              role="tab"
              data-key={p.key}
              id={`tab-${i}`}
              aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="ic"><svg viewBox="0 0 16 16" set:html={icons[p.key]} /></span>
              {p.name}
            </button>
          ))
        }
      </div>

      {
        products.map((p, i) => (
          <div
            class="panel panel-split"
            role="tabpanel"
            id={`panel-${i}`}
            aria-labelledby={`tab-${i}`}
            tabindex="0"
            hidden={i !== 0}
          >
            {p.replica ? (
              <figure class="shot-frame replica-frame">
                {p.replica === 'energy' ? (
                  <EnergyDashboard />
                ) : p.replica === 'equipment' ? (
                  <EquipmentDashboard />
                ) : p.replica === 'plantation' ? (
                  <PlantationDashboard />
                ) : p.replica === 'custom' ? (
                  <CustomDashboard />
                ) : (
                  <VisionDashboard />
                )}
              </figure>
            ) : p.screenshot ? (
              <figure class="shot-frame">
                <Image
                  src={p.screenshot}
                  alt={`${p.name} ${t.shot}`}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 900px) 92vw, 62vw"
                  loading="lazy"
                />
              </figure>
            ) : (
              <div class="mock">
                <div class="mock-top">
                  <span>{p.mock.top}</span>
                  <em>● Live</em>
                </div>
                <div class="metrics">
                  {p.mock.metrics.map(([value, label]) => (
                    <div class="metric">
                      <b>{value}</b>
                      <small>{label}</small>
                    </div>
                  ))}
                </div>
                <div class="spark">
                  <svg viewBox="0 0 300 110" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                      <linearGradient id={`sg-${i}`} x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0" stop-color="var(--live)" stop-opacity=".3" />
                        <stop offset="1" stop-color="var(--live)" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    <polygon
                      fill={`url(#sg-${i})`}
                      points={`0,110 ${sparkPoints(p.mock.line)} 300,110`}
                    />
                    <polyline
                      fill="none"
                      stroke="var(--live)"
                      stroke-width="2"
                      vector-effect="non-scaling-stroke"
                      points={sparkPoints(p.mock.line)}
                    />
                  </svg>
                </div>
              </div>
            )}

            <div class="panel-copy">
              <div class="panel-text">
                <h3>{p.name}</h3>
                <p class="desc">{p.desc}</p>
              </div>
              <a class="btn primary" href={demoLink(p.name, lang)} target="_blank" rel="noopener">{p.cta ?? t.demo}</a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tablist = document.getElementById('tablist')
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute('aria-controls')!)
    )

    function select(index: number, moveFocus = false) {
      tabs.forEach((tab, i) => {
        const active = i === index
        tab.setAttribute('aria-selected', String(active))
        tab.tabIndex = active ? 0 : -1
        const panel = panels[i]
        if (!panel) return
        panel.hidden = !active
        if (active) {
          // restart the swap animation
          panel.classList.remove('swap')
          void panel.offsetWidth
          panel.classList.add('swap')
        }
      })
      tabs[index].scrollIntoView({ block: 'nearest', inline: 'nearest' })
      if (moveFocus) tabs[index].focus()
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)))

    // The navbar's product links point at #product-<key>: open that tab.
    const fromHash = () => {
      const key = location.hash.startsWith('#product-') ? location.hash.slice(9) : ''
      const i = tabs.findIndex((t) => t.dataset.key === key)
      if (i >= 0) select(i)
    }
    window.addEventListener('hashchange', fromHash)
    fromHash()

    tablist.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
      const count = tabs.length
      if (['ArrowDown', 'ArrowRight'].includes(event.key)) {
        event.preventDefault()
        select((current + 1) % count, true)
      }
      if (['ArrowUp', 'ArrowLeft'].includes(event.key)) {
        event.preventDefault()
        select((current - 1 + count) % count, true)
      }
      if (event.key === 'Home') {
        event.preventDefault()
        select(0, true)
      }
      if (event.key === 'End') {
        event.preventDefault()
        select(count - 1, true)
      }
    })
  }
</script>
