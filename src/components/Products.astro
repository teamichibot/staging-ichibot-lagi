---
import { Image } from 'astro:assets'
import { products } from '../data/products'

const icons: Record<string, string> = {
  energy: '<path d="M9 1 3 9h5l-1 6 6-8H8z"/>',
  vision: '<rect x="1.5" y="3.5" width="13" height="9" rx="1.5"/><circle cx="8" cy="8" r="2.5"/>',
  equip: '<circle cx="8" cy="8" r="6"/><path d="M8 8l4-3"/>',
  marine:
    '<path d="M1.5 12c1.5 1.5 3 1.5 4.5 0s3-1.5 4.5 0 3 1 4 .5"/><path d="M4 10V5h8v5M8 5V2"/>',
  plant:
    '<path d="M8 15V7"/><path d="M8 9C5 9 3 7 3 4c3 0 5 2 5 5z"/><path d="M8 7c0-3 2-5 5-5 0 3-2 5-5 5z"/>',
}

/** Same polyline maths as the draft, run at build time instead of in the browser. */
function sparkPoints(values: number[]) {
  const w = 300
  const h = 110
  const max = 70
  const step = w / (values.length - 1)
  return values
    .map((y, i) => `${(i * step).toFixed(1)},${(h - (y / max) * h * 0.9).toFixed(1)}`)
    .join(' ')
}
---

<section id="products">
  <div class="wrap">
    <h2>Products proven in the field, ready to deploy</h2>
    <p class="lede">
      Every Ichibot product started as a real project for a real client. We packaged what
      worked, so you get a tested system instead of an experiment.
    </p>

    <div class="tabs">
      <div class="tablist" role="tablist" aria-label="Products" id="tablist">
        {
          products.map((p, i) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={`tab-${i}`}
              aria-controls={`panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              <span class="ic"><svg viewBox="0 0 16 16" set:html={icons[p.key]} /></span>
              {p.name}
              {p.pilot && <span class="pill">Pilot</span>}
            </button>
          ))
        }
      </div>

      {
        products.map((p, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${i}`}
            aria-labelledby={`tab-${i}`}
            tabindex="0"
            hidden={i !== 0}
          >
            <div>
              <h3>{p.name}</h3>
              <p class="desc">{p.desc}</p>
              <dl>
                <div>
                  <dt>What's included</dt>
                  <dd>{p.included}</dd>
                </div>
                <div>
                  <dt>{p.proofLabel}</dt>
                  <dd>
                    <ul class="proof">
                      {p.proof.map((x) => <li>{x}</li>)}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt>Deployment</dt>
                  <dd>{p.deploymentTime}</dd>
                </div>
              </dl>
              <div style="margin-top:1.6rem">
                <a class="btn sm" href="#contact">Request a demo</a>
              </div>
            </div>

            {p.screenshot ? (
              <figure class="shot-frame">
                <Image
                  src={p.screenshot}
                  alt={`${p.name} dashboard`}
                  widths={[640, 960, 1280]}
                  sizes="(max-width: 900px) 92vw, 46vw"
                  loading="lazy"
                />
              </figure>
            ) : (
            <div class="mock">
              <div class="mock-top">
                <span>{p.mock.top}</span>
                <em>● Live</em>
              </div>
              <div class="metrics">
                {p.mock.metrics.map(([value, label]) => (
                  <div class="metric">
                    <b>{value}</b>
                    <small>{label}</small>
                  </div>
                ))}
              </div>
              <div class="spark">
                <svg viewBox="0 0 300 110" preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id={`sg-${i}`} x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="var(--live)" stop-opacity=".3" />
                      <stop offset="1" stop-color="var(--live)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <polygon
                    fill={`url(#sg-${i})`}
                    points={`0,110 ${sparkPoints(p.mock.line)} 300,110`}
                  />
                  <polyline
                    fill="none"
                    stroke="var(--live)"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"
                    points={sparkPoints(p.mock.line)}
                  />
                </svg>
              </div>
            </div>
            )}
          </div>
        ))
      }
    </div>

    <span class="note">
      Draft: fill in the deployment time per product. Mockup numbers are illustrative —
      replace with real dashboard screenshots.
    </span>
  </div>
</section>

<script>
  const tablist = document.getElementById('tablist')
  if (tablist) {
    const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map((t) =>
      document.getElementById(t.getAttribute('aria-controls')!)
    )

    function select(index: number, moveFocus = false) {
      tabs.forEach((tab, i) => {
        const active = i === index
        tab.setAttribute('aria-selected', String(active))
        tab.tabIndex = active ? 0 : -1
        const panel = panels[i]
        if (!panel) return
        panel.hidden = !active
        if (active) {
          // restart the swap animation
          panel.classList.remove('swap')
          void panel.offsetWidth
          panel.classList.add('swap')
        }
      })
      if (moveFocus) tabs[index].focus()
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)))

    tablist.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')
      const count = tabs.length
      if (['ArrowDown', 'ArrowRight'].includes(event.key)) {
        event.preventDefault()
        select((current + 1) % count, true)
      }
      if (['ArrowUp', 'ArrowLeft'].includes(event.key)) {
        event.preventDefault()
        select((current - 1 + count) % count, true)
      }
      if (event.key === 'Home') {
        event.preventDefault()
        select(0, true)
      }
      if (event.key === 'End') {
        event.preventDefault()
        select(count - 1, true)
      }
    })
  }
</script>
