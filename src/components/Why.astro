 */
const reasons = [
  {
    title: 'Proven at scale',
    body: 'Systems running at Pertamina, Toyota Indonesia and national agribusiness groups.',
    anchor: 'Pertamina · Toyota Indonesia · Citra Borneo Utama',
  },
  {
    title: 'Works with old machines',
    body: 'We retrofit sensors and read existing PLCs, so you get data without replacing equipment.',
    anchor: 'Modbus RTU/TCP · OPC UA · RS-485 · RTSP',
  },
  {
    title: 'Global capability, local price',
    body: 'Edge and dashboard features on par with global brands, at a cost that fits Indonesian plants.',
    anchor: 'Built and supported in Indonesia',
  },
  {
    title: 'Engineers who show up',
    body: 'Our own team surveys, installs, trains and supports, from Yogyakarta to your site.',
    anchor: 'In-house team, based in Yogyakarta',
  },
