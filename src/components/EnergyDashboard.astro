---
/**
 * A built-in-HTML replica of the Power Monitoring System dashboard, used in
 * place of the screenshot on the Smart energy monitoring product. Figures are
 * the ones from the anonymised capture (Power Meter 1 / Production room A);
 * no client is named.
 *
 * Laid out at a fixed design width inside ReplicaFit, which scales it to its
 * container. Colours come from the site tokens, so it follows light and dark.
 */
import ReplicaFit from './ReplicaFit.astro'

// Laid out wider than the other replicas: at 1320px its natural height is
// about 825px, the 16:10 of the real dashboard screen, so it fills its frame
// at full width like a screenshot instead of shrinking into it.
const W = 1320

/** Seeded, so every build draws the same spikes. */
function series(seed: number, n: number, shape: (i: number, r: () => number) => number) {
  let s = seed
  const r = () => ((s = (s * 16807) % 2147483647) / 2147483647)
  return Array.from({ length: n }, (_, i) => shape(i, r))
}
// meter 1: bursts during working shifts, flat overnight gaps
const m1 = series(11, 180, (i, r) => {
  const day = i % 30
  const idle = day > 22 && day < 27
  return idle ? 0.06 + r() * 0.04 : 0.25 + r() * 0.75
})
// meter 2: a steadier daily rhythm
const m2 = series(29, 180, (i, r) => 0.35 + Math.abs(Math.sin(i / 2.6)) * 0.5 + r() * 0.15)

const path = (vals: number[], w = 480, h = 54) =>
  vals.map((v, i) => `${i ? 'L' : 'M'}${((i / (vals.length - 1)) * w).toFixed(1)} ${(h - v * h * 0.92).toFixed(1)}`).join('')

const meters = [
  {
    name: 'Power Meter 1',
    place: 'Production room A',
    va: 43650,
    pct: 4.2,
    capacity: '1,040,000',
    peak: '446,704',
    peakPct: '43.0%',
    peakAt: '15 Sep, 09:52',
    avg: '136',
    trend: path(m1),
    grid: 3,
    cells: [
      ['Active Power', '39 kW'], ['Frequency', '50.01 Hz'], ['Power Factor', '0.90'],
      ['Voltage (R)', '232.4 V'], ['Voltage (S)', '235.4 V'], ['Voltage (T)', '233.6 V'],
      ['Current (R)', '76.0 A'], ['Current (S)', '58.5 A'], ['Current (T)', '58.5 A'],
    ],
    reading: '2,516,229 / 2,592,000',
    energy: '85,977 kWh',
    bill: 'Rp 96,494,368',
    tariff: 'Rp 1,036/kWh',
  },
  {
    name: 'Power Meter 2',
    place: 'Production room B',
    va: 686,
    pct: 9.8,
    capacity: '7,000',
    peak: '6,214',
    peakPct: '88.8%',
    peakAt: '21 Sep, 12:16',
    avg: '2',
    trend: path(m2),
    grid: 2,
    cells: [
      ['Active Power', '618.19 W'], ['Current', '2.94 A'],
      ['Voltage', '246.75 V'], ['Frequency', '50.0 Hz'],
      ['Power Factor', '0.90'],
    ],
    reading: '2,506,635 / 2,592,000',
    energy: '1,689 kWh',
    bill: 'Rp 3,378,045',
    tariff: 'Rp 2,000/kWh',
  },
]
const ranges = ['1H', '1D', '7D', '30D', 'This month']

/** Readings that scale with load (active power, currents) get their base value exposed to the live script. */
const scalable = (label: string, value: string) => {
  if (!/^(Active Power|Current)/.test(label)) return null
  const [num, unit] = value.split(' ')
  return { n: Number(num), unit, dp: (num.split('.')[1] ?? '').length }
}
---

<ReplicaFit width={W} ratio={10 / 16} label="Power monitoring dashboard with two power meters showing apparent power, a 30-day trend, per-phase readings, total energy and estimated bill">
  <div class="edash">
    <header class="ed-top">
      <span class="ed-brand">
        <svg viewBox="0 0 20 20"><path d="M1 11h4l2.5-6 4 11 2.5-7H19" /></svg>
        <span><b>Power Monitoring System</b><small><i></i>Live Monitoring</small></span>
      </span>
      <span class="ed-ranges">
        {ranges.map((r) => <em class:list={{ on: r === '30D' }}>{r}</em>)}
        <em class="ed-custom">Custom ▾</em>
      </span>
      <span class="ed-clock" data-clock>27 September 2026 · 09:42:10</span>
      <span class="ed-btn">Dashboard</span>
    </header>

    <div class="ed-meters">
      {meters.map((m, mi) => (
        <section class="ed-card" data-cap={Number(m.capacity.replace(/,/g, ''))} data-base-pct={m.pct}>
          <div class="ed-card-head">
            <span class="ed-ic"><svg viewBox="0 0 20 20"><path d="M1 11h4l2.5-6 4 11 2.5-7H19" /></svg></span>
            <span><b>{m.name}</b><small>{m.place}</small></span>
            <span class="ed-ok" data-status>✓ NORMAL</span>
          </div>

          <div class="ed-big">
            <b data-va>{m.va.toLocaleString('en-US')}</b><span>VA</span>
          </div>
          <p class="ed-sub">Apparent Power <b data-pct>{m.pct}%</b><br />of <b>{m.capacity} VA</b> capacity</p>
          <div class="ed-bar"><i data-bar style={`width:${Math.max(m.pct, 3)}%`}></i></div>
          <p class="ed-cap">Percentage of apparent power usage</p>

          <div class="ed-trend">
            <div class="ed-trend-head"><span>Apparent power</span><span>30D</span></div>
            <svg viewBox="0 0 480 54" preserveAspectRatio="none">
              <path class="ed-line" d={m.trend} />
            </svg>
            <div class="ed-trend-foot">
              <div data-peak={Number(m.peak.replace(/,/g, ''))}><small>Peak</small><b><span data-peak-va>{m.peak}</span> <em>VA · <span data-peak-pct>{m.peakPct}</span></em></b><small data-peak-at>{m.peakAt}</small></div>
              <div><small>Total (avg)</small><b>{m.avg} <em>kVA</em></b><small>Total in selected range</small></div>
            </div>
          </div>

          <div class="ed-grid" style={`grid-template-columns:repeat(${m.grid},1fr)`}>
            {m.cells.map(([label, value]) => {
              const sc = scalable(label, value)
              return (
                <div>
                  <small>{label}</small>
                  {sc ? <b data-scale={sc.n} data-unit={sc.unit} data-dp={sc.dp}>{value}</b> : <b>{value}</b>}
                </div>
              )
            })}
          </div>

          <div class="ed-range">
            <div class="ed-range-head">
              <span><b>Range 30D</b><small>24 Aug, 05:25 → 23 Sep, 05:25</small></span>
              <span class="ed-reading">{m.reading}</span>
            </div>
            <div class="ed-row"><span>Total energy</span><b class="ed-green">{m.energy}</b></div>
            <div class="ed-row"><span>Estimated bill</span><b class="ed-green">{m.bill}</b></div>
            <div class="ed-row ed-tariff"><span>Active tariff</span><span>{m.tariff}</span></div>
          </div>
        </section>
      ))}
    </div>
  </div>
</ReplicaFit>

<script>
  // Live feel while on screen: the clock ticks, and each meter's load idles
  // near its base level with small jitter, then now and then surges to
  // roughly 70-82% of capacity for a few seconds before easing back. VA,
  // percentage, bar, status and the load-dependent readings follow. Off under
  // prefers-reduced-motion.
  for (const dash of document.querySelectorAll<HTMLElement>('.edash')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) break
    const clock = dash.querySelector<HTMLElement>('[data-clock]')
    const cards = Array.from(dash.querySelectorAll<HTMLElement>('.ed-card')).map((card, i) => ({
      card,
      cap: Number(card.dataset.cap),
      base: Number(card.dataset.basePct),
      pct: Number(card.dataset.basePct),
      target: Number(card.dataset.basePct),
      hold: 0,
      surging: false,
      // stagger the first surge so the two meters do not peak together
      wait: i === 0 ? 6 : 18,
      va: card.querySelector<HTMLElement>('[data-va]')!,
      pctEl: card.querySelector<HTMLElement>('[data-pct]')!,
      bar: card.querySelector<HTMLElement>('[data-bar]')!,
      status: card.querySelector<HTMLElement>('[data-status]')!,
      scaled: Array.from(card.querySelectorAll<HTMLElement>('[data-scale]')),
      peakBox: card.querySelector<HTMLElement>('[data-peak]')!,
    }))
    let t = new Date(2026, 8, 27, 9, 42, 10).getTime()
    let ticks = 0
    let timer = 0

    const step = () => {
      if (++ticks % 2 === 0) {
        t += 1000
        const d = new Date(t)
        const p = (n: number) => String(n).padStart(2, '0')
        if (clock) clock.textContent = `27 September 2026 · ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`
      }
      for (const m of cards) {
        if (m.hold > 0) m.hold--
        else if (m.surging) {
          m.surging = false
          m.wait = 16 + Math.floor(Math.random() * 20)
          m.target = m.base
        } else if (--m.wait <= 0) {
          m.surging = true
          m.hold = 10 + Math.floor(Math.random() * 8)
          m.target = 70 + Math.random() * 12
        } else {
          m.target = m.base * (0.9 + Math.random() * 0.25)
        }
        m.pct += (m.target - m.pct) * 0.35

        const high = m.pct >= 75
        const va = Math.round((m.cap * m.pct) / 100)
        m.va.textContent = va.toLocaleString('en-US')
        // a surge above the recorded peak becomes the new peak, stamped now
        if (va > Number(m.peakBox.dataset.peak)) {
          m.peakBox.dataset.peak = String(va)
          m.peakBox.querySelector('[data-peak-va]')!.textContent = va.toLocaleString('en-US')
          m.peakBox.querySelector('[data-peak-pct]')!.textContent = `${m.pct.toFixed(1)}%`
          const d = new Date(t)
          const p = (n: number) => String(n).padStart(2, '0')
          m.peakBox.querySelector('[data-peak-at]')!.textContent = `27 Sep, ${p(d.getHours())}:${p(d.getMinutes())}`
        }
        m.pctEl.textContent = `${m.pct.toFixed(1)}%`
        m.bar.style.width = `${Math.max(m.pct, 3)}%`
        m.card.classList.toggle('high', high)
        m.status.textContent = high ? '▲ HIGH LOAD' : '✓ NORMAL'
        const k = m.pct / m.base
        for (const el of m.scaled) {
          el.textContent = `${(Number(el.dataset.scale) * k).toLocaleString('en-US', {
            minimumFractionDigits: Number(el.dataset.dp),
            maximumFractionDigits: Number(el.dataset.dp),
          })} ${el.dataset.unit}`
        }
      }
    }

    new IntersectionObserver(([e]) => {
      clearInterval(timer)
      if (e.isIntersecting) timer = window.setInterval(step, 500)
    }).observe(dash)
  }
</script>
