---
import { EMAIL, WHATSAPP_NUMBER, socials, whatsappLinkFor } from '../lib/contact'
import { basePath, langFromUrl, localize } from '../i18n'

/**
 * Contact details, social links and the Internship and ecosystem URLs are the
 * ones the old site used. Section anchors live on the homepage.
 */
const lang = langFromUrl(Astro.url)
const home = basePath(Astro.url.pathname) === '/' ? '' : localize('/', lang)
const whatsappLink = whatsappLinkFor(lang)
const t = {
  en: { home: 'Ichibot home', about: 'PT Gagas Anagata Semesta. Intelligent industrial hub from Yogyakarta, Indonesia.', products: 'Products', company: 'Company', aboutLink: 'About', cases: 'Case studies', insights: 'Insights', internship: 'Internship', ecosystem: 'Ecosystem', training: 'Training', contact: 'Contact' },
  id: { home: 'Beranda Ichibot', about: 'PT Gagas Anagata Semesta. Intelligent industrial hub dari Yogyakarta, Indonesia.', products: 'Produk', company: 'Perusahaan', aboutLink: 'Tentang kami', cases: 'Studi kasus', insights: 'Artikel', internship: 'Magang', ecosystem: 'Ekosistem', training: 'Pelatihan', contact: 'Kontak' },
}[lang]
const waDisplay = `+${WHATSAPP_NUMBER.slice(0, 2)} ${WHATSAPP_NUMBER.slice(2, 5)}-${WHATSAPP_NUMBER.slice(5, 9)}-${WHATSAPP_NUMBER.slice(9)}`
const ext = { target: '_blank', rel: 'noopener' }
---

<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="brand" href={localize('/', lang)} aria-label={t.home}><span class="logo" role="img" aria-label="Ichibot"></span></a>
        <p class="foot-about">{t.about}</p>
        <ul class="foot-contact">
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li><a href={whatsappLink} {...ext}>WhatsApp {waDisplay}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t.products}</h3>
        <ul>
          <li><a href={`${home}#product-energy`}>Smart energy monitoring</a></li>
          <li><a href={`${home}#product-equip`}>Smart equipment monitoring</a></li>
          <li><a href={`${home}#product-plant`}>Smart plantation system</a></li>
          <li><a href={`${home}#product-vision`}>AI Vision Engine</a></li>
          <li><a href={`${home}#product-custom`}>Custom</a></li>
        </ul>
      </div>
      <div>
        <h3>{t.company}</h3>
        <ul>
          <li><a href={localize('/about', lang)}>{t.aboutLink}</a></li>
          <li><a href={`${home}#cases`}>{t.cases}</a></li>
          <li><a href={localize('/blog', lang)}>{t.insights}</a></li>
          <li><a href="https://internship.ichibot.id" {...ext}>{t.internship}</a></li>
        </ul>
      </div>
      <div>
        <h3>{t.ecosystem}</h3>
        <ul>
          <li><a href="https://www.store.ichibot.id" {...ext}>Ichibot Store</a></li>
          <li><a href="https://robotics.ichibot.id" {...ext}>Ichibot Robotics</a></li>
          <li><a href={`${home}#services`}>{t.training}</a></li>
          <li><a href={localize('/contact', lang)}>{t.contact}</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 PT Gagas Anagata Semesta</span>
      <span class="foot-social">
        {socials.map((s) => <a href={s.href} {...ext}>{s.label}</a>)}
      </span>
    </div>
  </div>
</footer>
