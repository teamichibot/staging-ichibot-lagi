---
import { EMAIL, WHATSAPP_NUMBER, socials, whatsappLink } from '../lib/contact'

/**
 * Contact details, social links and the Internship and ecosystem URLs are the
 * ones the old site used. Section anchors live on the homepage.
 */
const home = Astro.url.pathname === '/' ? '' : '/'
const waDisplay = `+${WHATSAPP_NUMBER.slice(0, 2)} ${WHATSAPP_NUMBER.slice(2, 5)}-${WHATSAPP_NUMBER.slice(5, 9)}-${WHATSAPP_NUMBER.slice(9)}`
const ext = { target: '_blank', rel: 'noopener' }
---

<footer class="site">
  <div class="wrap">
    <div class="foot">
      <div>
        <a class="brand" href="/" aria-label="Ichibot home"><span class="logo" role="img" aria-label="Ichibot"></span></a>
        <p class="foot-about">PT Gagas Anagata Semesta. Intelligent industrial hub from Yogyakarta, Indonesia.</p>
        <ul class="foot-contact">
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li><a href={whatsappLink} {...ext}>WhatsApp {waDisplay}</a></li>
        </ul>
      </div>
      <div>
        <h4>Products</h4>
        <ul>
          <li><a href={`${home}#product-energy`}>Smart energy monitoring</a></li>
          <li><a href={`${home}#product-equip`}>Smart equipment monitoring</a></li>
          <li><a href={`${home}#product-plant`}>Smart plantation system</a></li>
          <li><a href={`${home}#product-vision`}>AI Vision Engine</a></li>
          <li><a href={`${home}#product-custom`}>Custom</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="/about">About</a></li>
          <li><a href={`${home}#cases`}>Case studies</a></li>
          <li><a href="/blog">Insights</a></li>
          <li><a href="https://internship.ichibot.id" {...ext}>Internship</a></li>
        </ul>
      </div>
      <div>
        <h4>Ecosystem</h4>
        <ul>
          <li><a href="https://www.store.ichibot.id" {...ext}>Ichibot Store</a></li>
          <li><a href="https://robotics.ichibot.id" {...ext}>Ichibot Robotics</a></li>
          <li><a href={`${home}#services`}>Training</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>
    </div>
    <div class="legal">
      <span>© 2026 PT Gagas Anagata Semesta</span>
      <span class="foot-social">
        {socials.map((s) => <a href={s.href} {...ext}>{s.label}</a>)}
      </span>
    </div>
  </div>
</footer>
