---
import { getClientLogos } from '../lib/site-data'

/**
 * Client logos, read live from Supabase (`site_data.clients.industry`), the
 * list managed in the admin panel under Logo Klien, so adding or reordering a
 * client there changes this row without a deploy.
 *
 * The logos come from many hosts in many colours, so they get one treatment:
 * grayscale in light mode, grayscale-inverted in dark mode (a white JPG
 * background inverts to black and disappears into the page). They run as a
 * marquee: the list is rendered twice and the track slides by exactly one copy,
 * so the loop is seamless. Hover pauses it; reduced motion shows a static,
 * wrapping row instead.
 */
const logos = await getClientLogos()
---

{
  logos.length > 0 && (
    <section class="logos">
      <div class="wrap">
        <p>Trusted by state-owned enterprises, manufacturers and institutions in Indonesia</p>
      </div>
      <div class="marquee" style={`--n:${logos.length}`}>
        <div class="marquee-track">
          {[0, 1].map((copy) => (
            <ul class="marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
              {logos.map((c) => (
                <li>
                  <img src={c.logo} alt={copy === 0 ? c.name : ''} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>
  )
}

<script>
  // Some client sites block hotlinking; drop a logo that fails to load (in
  // both copies of the marquee) rather than show a broken image.
  for (const img of document.querySelectorAll<HTMLImageElement>('.marquee-list img')) {
    const drop = () => {
      const i = [...img.closest('ul')!.children].indexOf(img.closest('li')!)
      document.querySelectorAll('.marquee-list').forEach((ul) => ul.children[i]?.classList.add('failed'))
    }
    if (img.complete && img.naturalWidth === 0) drop()
    else img.addEventListener('error', drop)
  }
</script>

