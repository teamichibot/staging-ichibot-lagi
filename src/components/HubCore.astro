---
import { langFromUrl } from '../i18n'

/**
 * The hub diagram's core, drawn as the edge gateway it is: a dark hardware
 * body with corner screws, a port on each side for every wire, live message
 * and CPU readouts, status LEDs and a vent. `ports` are the y positions where
 * wires land on the left and leave on the right. The compact variant (phone
 * diagram) drops the readouts and vent to fit a smaller box.
 */
interface Props {
  x: number
  y: number
  w: number
  h: number
  portsIn?: number[]
  portsOut?: number[]
  compact?: boolean
}
const { x, y, w, h, portsIn = [], portsOut = [], compact = false } = Astro.props
const cx = x + w / 2
const sub = langFromUrl(Astro.url) === 'id' ? 'Kumpulkan · catat · jalankan AI' : 'Collect · log · run AI'
const leds = ['PWR', 'NET', 'RUN', 'AI']
const ledStep = (w - 60) / (leds.length - 1)
const ledY = compact ? y + h - 26 : y + 186
---

<g class="dev">
  <rect class="dev-ring" x={x - 8} y={y - 8} width={w + 16} height={h + 16} rx="20" />
  <rect class="dev-body" x={x} y={y} width={w} height={h} rx="14" />
  <rect class="dev-face" x={x + 6} y={y + 6} width={w - 12} height={h - 12} rx="10" />
  {[[x + 12, y + 12], [x + w - 12, y + 12], [x + 12, y + h - 12], [x + w - 12, y + h - 12]].map(([sx, sy]) => (
    <g class="dev-screw"><circle cx={sx} cy={sy} r="2.6" /><path d={`M${sx - 1.4} ${sy}h2.8`} /></g>
  ))}
  {portsIn.map((py) => <rect class="dev-port" x={x - 5} y={py - 5} width="10" height="10" rx="2" />)}
  {portsOut.map((py) => <rect class="dev-port" x={x + w - 5} y={py - 5} width="10" height="10" rx="2" />)}

  {!compact && (
    <>
      <rect x={x + 22} y={y + 20} width="9" height="9" rx="2" fill="var(--accent)" />
      <text class="dev-tag" x={x + 37} y={y + 28}>EDGE GATEWAY</text>
    </>
  )}
  <text class="dev-name" x={cx} y={compact ? y + 38 : y + 64} text-anchor="middle">Ichibot</text>
  <text class="dev-name" x={cx} y={compact ? y + 58 : y + 84} text-anchor="middle">Smart System</text>
  <text class="dev-sub" x={cx} y={compact ? y + 76 : y + 104} text-anchor="middle">{sub}</text>

  {!compact && (
    <>
      <path class="dev-rule" d={`M${x + 20} ${y + 118}h${w - 40}`} />
      <text class="dev-k" x={x + 24} y={y + 136}>MSG/S</text>
      <text class="dev-v" x={x + 24} y={y + 154} data-hubval="1284" data-step="60" data-dp="0">1,284</text>
      <text class="dev-k" x={x + w / 2 + 8} y={y + 136}>CPU</text>
      <text class="dev-v" x={x + w / 2 + 8} y={y + 154} data-hubval="23" data-step="4" data-dp="0" data-unit="%">23%</text>
    </>
  )}

  {leds.map((label, i) => (
    <g class={`dev-led led-${label.toLowerCase()}`}>
      <circle cx={x + 30 + i * ledStep} cy={ledY} r="3.4" />
      <text x={x + 30 + i * ledStep} y={ledY + 14} text-anchor="middle">{label}</text>
    </g>
  ))}

  {!compact && Array.from({ length: 13 }, (_, i) => (
    <path class="dev-vent" d={`M${cx - 36 + i * 6} ${y + h - 20}v8`} />
  ))}
</g>
