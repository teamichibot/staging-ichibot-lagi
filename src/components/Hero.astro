---
import HubCore from './HubCore.astro'
import { langFromUrl } from '../i18n'

const lang = langFromUrl(Astro.url)
const t = {
  en: {
    lede: "We help Indonesian industries connect every machine with industrial IoT, see what's happening in real time, and act on it, from the shop floor to your ERP.",
    survey: 'Book a site survey', explore: 'Explore products',
    diagram: 'Machines, sensors, cameras and meters send data to the Ichibot Smart System, which delivers it to dashboards, ERP, alerts and AI insights',
    synced: '✓ Synced', newAlerts: 'new', anomaly: '1 anomaly',
  },
  id: {
    lede: 'Kami membantu industri Indonesia menghubungkan setiap mesin dengan industrial IoT, melihat kondisi secara real-time, dan bertindak cepat, dari lantai produksi hingga ERP Anda.',
    survey: 'Jadwalkan survei lokasi', explore: 'Lihat produk',
    diagram: 'Mesin, sensor, kamera, dan meter mengirim data ke Ichibot Smart System, yang meneruskannya ke dashboard, ERP, peringatan, dan analisis AI',
    synced: '✓ Tersinkron', newAlerts: 'baru', anomaly: '1 anomali',
  },
}[lang]
/** Rough width of a chip label in the 9.5px chip font, plus padding. */
const chipW = (text: string) => Math.round(text.length * 5.4 + 14)

/**
 * Hub diagram: sources feed the Ichibot Smart System gateway, which feeds
 * the outputs. Originally lifted from the approved draft. The nodes
 * are generated from data rather than eight hand-written SVG groups, so a label
 * or an icon can change in one place.
 *
 * Icons are 16x16 in their own coordinate space and translated into position;
 * each draws the thing the node is, not a generic glyph.
 *
 * The pulse circles are generated client-side because there are 16 of them and
 * they only differ by which path they ride.
 */
const icons = {
  // a controller module with its terminal block
  plc: '<rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M5.6 3v10"/><path d="M8 6.2h3.6M8 9.8h3.6"/>',
  // a dial reading a physical quantity
  sensor: '<circle cx="8" cy="8" r="5.6"/><path d="M8 8l3-2.4"/><path d="M8 2.4v1.4M13.6 8h-1.4M8 13.6v-1.4M2.4 8h1.4"/>',
  // a video camera
  camera: '<rect x="1.6" y="4.2" width="9.4" height="7.6" rx="1.6"/><path d="M11 7.2l3.4-2.2v6l-3.4-2.2z"/>',
  // a meter with a bolt in it
  meter: '<rect x="2" y="2" width="12" height="12" rx="2"/><path d="M8.8 4.4 6.1 8.4h2l-.7 3.2 2.9-4.2h-2z"/>',
  // a chart on a screen
  dashboard: '<rect x="1.6" y="2.6" width="12.8" height="10.8" rx="1.6"/><path d="M4.8 10.8V8.4M8 10.8V5.6M11.2 10.8V7.6"/>',
  // a database
  erp: '<ellipse cx="8" cy="4" rx="5" ry="2"/><path d="M3 4v8c0 1.1 2.2 2 5 2s5-.9 5-2V4"/><path d="M3 8c0 1.1 2.2 2 5 2s5-.9 5-2"/>',
  // a bell
  alert: '<path d="M4.2 6.8a3.8 3.8 0 0 1 7.6 0c0 2.9 1.1 4 1.1 4H3.1s1.1-1.1 1.1-4z"/><path d="M6.7 13a1.5 1.5 0 0 0 2.6 0"/>',
  // a spark, for something inferred rather than measured
  ai: '<path d="M6.6 2.2 7.8 5.4 11 6.6 7.8 7.8 6.6 11 5.4 7.8 2.2 6.6 5.4 5.4z"/><path d="M11.6 10.2l.7 1.5 1.5.7-1.5.7-.7 1.5-.7-1.5-1.5-.7 1.5-.7z"/>',
}

/** Left column feeds the system; right column is what it feeds. */
const sources = [
  { y: 70, icon: 'plc', title: 'PLC/Controllers', sub: 'Modbus RTU / TCP', short: 'Modbus RTU/TCP', live: { text: 'RUN' } },
  { y: 155, icon: 'sensor', title: 'Sensors', sub: 'Temp, pressure, vibration', short: 'Temp, pressure', live: { text: '7.2 bar', 'data-hubval': '7.2', 'data-step': '0.08', 'data-dp': '1', 'data-unit': ' bar' } },
  { y: 240, icon: 'camera', title: 'IP cameras', sub: 'RTSP video', short: 'RTSP video', live: { text: '4 streams' } },
  { y: 325, icon: 'meter', title: 'Energy meters', sub: 'kWh, power quality', short: 'kWh, quality', live: { text: '412 kW', 'data-hubval': '412', 'data-step': '6', 'data-dp': '0', 'data-unit': ' kW' } },
]

const outputs = [
  { y: 70, icon: 'dashboard', title: 'Dashboard', sub: 'Live KPIs and trends', short: 'KPIs, trends' },
  { y: 155, icon: 'erp', title: 'ERP / MES', sub: 'Automatic data sync', short: 'Auto data sync' },
  { y: 240, icon: 'alert', title: 'Alerts', sub: 'WhatsApp, email, siren', short: 'WhatsApp, email' },
  { y: 325, icon: 'ai', title: 'AI insights', sub: 'Anomalies, detections', short: 'Anomalies' },
]

/** Bahasa labels for the diagram nodes, in the same order as above. */
if (lang === 'id') {
  const src = [
    { title: 'PLC/Kontroler', sub: 'Modbus RTU / TCP', short: 'Modbus RTU/TCP' },
    { title: 'Sensor', sub: 'Suhu, tekanan, getaran', short: 'Suhu, tekanan' },
    { title: 'Kamera IP', sub: 'Video RTSP', short: 'Video RTSP', live: { text: '4 stream' } },
    { title: 'Meter energi', sub: 'kWh, kualitas daya', short: 'kWh, kualitas' },
  ]
  const out = [
    { title: 'Dashboard', sub: 'KPI dan tren live', short: 'KPI, tren' },
    { title: 'ERP / MES', sub: 'Sinkron data otomatis', short: 'Sinkron otomatis' },
    { title: 'Peringatan', sub: 'WhatsApp, email, sirene', short: 'WhatsApp, email' },
    { title: 'Analisis AI', sub: 'Anomali, deteksi', short: 'Anomali' },
  ]
  src.forEach((o, i) => Object.assign(sources[i], o))
  out.forEach((o, i) => Object.assign(outputs[i], o))
}

/**
 * Narrow screens get a vertical version of the same diagram: sources in a 2x2
 * grid on top, the core in the middle, outputs in a 2x2 grid below. Top-row
 * sources and bottom-row outputs wire round the outside edges so no wire
 * crosses a node.
 */
const V = { w: 150, h: 50, cols: [24, 186], srcRows: [36, 98], outRows: [392, 454] }
const vIn = [
  'M24 61 C6 61 6 190 135 210',
  'M336 61 C354 61 354 190 225 210',
  'M99 148 C99 180 160 180 160 210',
  'M261 148 C261 180 200 180 200 210',
]
const vOut = [
  'M160 330 C160 360 99 360 99 392',
  'M200 330 C200 360 261 360 261 392',
  'M135 330 C6 350 6 479 24 479',
  'M225 330 C354 350 354 479 336 479',
]
const vPos = (i: number, rows: number[]) => ({ x: V.cols[i % 2], y: rows[Math.floor(i / 2)] })

/**
 * Desktop hub geometry. Each wire lands on its own port on the gateway
 * rather than all meeting at one point.
 */
const D = (() => {
  const srcX = 16, outX = 770, nodeW = 214, nodeH = 58
  const rows = [62, 148, 234, 320]
  const core = { x: 400, y: 110, w: 200, h: 230 }
  const ports = [183, 211, 239, 267]
  const inPaths = rows.map((r, i) => `M${srcX + nodeW} ${r + 29} C315 ${r + 29} 315 ${ports[i]} ${core.x} ${ports[i]}`)
  const outPaths = rows.map((r, i) => `M${core.x + core.w} ${ports[i]} C685 ${ports[i]} 685 ${r + 29} ${outX} ${r + 29}`)
  const spark = [[0, 14], [7, 10], [14, 12], [21, 6], [28, 9], [35, 4], [42, 7], [52, 2]]
  return { srcX, outX, nodeW, nodeH, rows, core, ports, inPaths, outPaths, spark }
})()
---

<section class="hero">
  <canvas class="hero-bg" aria-hidden="true"></canvas>
  <div class="wrap">
    <h1>Intelligent industrial hub</h1>
    <p class="lede">{t.lede}</p>
    <div class="actions">
      <a class="btn primary" href="#contact">{t.survey}</a>
      <a class="btn" href="#products">{t.explore}</a>
    </div>

    <div class="stage">
      {/* the diagram sits straight on the hero, over its glow: no window frame */}
      <div class="hub" role="img" aria-label={t.diagram}>
        <svg id="hubsvg" viewBox="0 42 1000 356">
          <defs>
            <linearGradient id="dev-metal" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#232833" /><stop offset="1" stop-color="#12151b" />
            </linearGradient>
          </defs>
          <g id="wires">
            {D.inPaths.map((d, i) => <path id={`i${i + 1}`} class="wire" d={d} />)}
            {D.outPaths.map((d, i) => <path id={`o${i + 1}`} class="wire" d={d} />)}
          </g>
          {sources.map((n, i) => {
            const y = D.rows[i]
            const { text: liveText, ...liveAttrs } = n.live
            return (
              <g class="node">
                <rect x={D.srcX} y={y} width={D.nodeW} height={D.nodeH} rx="10" />
                <g class="ic" transform={`translate(${D.srcX + 16} ${y + 21})`} set:html={icons[n.icon as keyof typeof icons]} />
                <text x={D.srcX + 46} y={y + 25}>{n.title}</text>
                <text class="sub" x={D.srcX + 46} y={y + 42}>{n.sub}</text>
                <circle class="live-dot" cx={D.srcX + D.nodeW - 14} cy={y + 21} r="2.6" />
                <text class="live" x={D.srcX + D.nodeW - 22} y={y + 25} text-anchor="end" {...liveAttrs}>{liveText}</text>
              </g>
            )
          })}
          <HubCore x={D.core.x} y={D.core.y} w={D.core.w} h={D.core.h} portsIn={D.ports} portsOut={D.ports} />
          {outputs.map((n, i) => {
            const y = D.rows[i]
            const rx = D.outX + D.nodeW - 14
            return (
              <g class="node">
                <rect x={D.outX} y={y} width={D.nodeW} height={D.nodeH} rx="10" />
                <g class="ic" transform={`translate(${D.outX + 16} ${y + 21})`} set:html={icons[n.icon as keyof typeof icons]} />
                <text x={D.outX + 46} y={y + 25}>{n.title}</text>
                <text class="sub" x={D.outX + 46} y={y + 42}>{n.sub}</text>
                {n.icon === 'dashboard' && <polyline class="spark" points={D.spark.map(([a, b]) => `${rx - 52 + a} ${y + 12 + b}`).join(' ')} />}
                {n.icon === 'erp' && (
                  <g class="chip ok"><rect x={rx - chipW(t.synced)} y={y + 13} width={chipW(t.synced)} height="17" rx="8.5" /><text x={rx - chipW(t.synced) / 2} y={y + 25} text-anchor="middle">{t.synced}</text></g>
                )}
                {n.icon === 'alert' && (
                  <g class="chip warn"><rect x={rx - 44} y={y + 13} width="44" height="17" rx="8.5" /><text x={rx - 22} y={y + 25} text-anchor="middle" data-alerts={t.newAlerts}>2 {t.newAlerts}</text></g>
                )}
                {n.icon === 'ai' && (
                  <g class="chip"><rect x={rx - chipW(t.anomaly)} y={y + 13} width={chipW(t.anomaly)} height="17" rx="8.5" /><text x={rx - chipW(t.anomaly) / 2} y={y + 25} text-anchor="middle">{t.anomaly}</text></g>
                )}
              </g>
            )
          })}
          <g class="pulses" data-wires="i1 i2 i3 i4 o1 o2 o3 o4"></g>
        </svg>
        <svg id="hubsvg-v" viewBox="0 18 360 504">
          <g>
            {vIn.map((d, i) => <path id={`vi${i + 1}`} class="wire" d={d} />)}
            {vOut.map((d, i) => <path id={`vo${i + 1}`} class="wire" d={d} />)}
          </g>
          {[...sources.map((n, i) => ({ n, ...vPos(i, V.srcRows) })), ...outputs.map((n, i) => ({ n, ...vPos(i, V.outRows) }))].map(({ n, x, y }) => (
            <g class="node">
              <rect x={x} y={y} width={V.w} height={V.h} rx="10" />
              <g class="ic" transform={`translate(${x + 12} ${y + 17})`} set:html={icons[n.icon as keyof typeof icons]} />
              <text x={x + 36} y={y + 22}>{n.title}</text>
              <text class="sub" x={x + 36} y={y + 38}>{n.short}</text>
            </g>
          ))}
          <HubCore x={105} y={210} w={150} h={120} compact />
          <g class="pulses" data-wires="vi1 vi2 vi3 vi4 vo1 vo2 vo3 vo4"></g>
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Hero background: a fine, even dot matrix with two broad, slow waves of
   * brightness passing through it. The brightest band picks up the accent
   * colour. Dots near the pointer light up and follow it with a little lag;
   * while the pointer is over the hero the wave's accent steps back so the
   * pointer is the one highlight. Colours come from the CSS tokens, so it
   * follows the theme; it pauses off-screen and in hidden tabs. Under
   * prefers-reduced-motion the waves hold still and the pointer highlight
   * snaps to position instead of easing.
   *
   * On first load the dots draw a map of Indonesia: the islands light up in
   * the accent colour, sweeping west to east, hold, then dissolve into the
   * waves. The hero's centre mask opens for it (the .intro class) and closes
   * again as the map fades. Coastlines are simplified; at a 16px dot pitch
   * that is all the detail the grid can show. Skipped under reduced motion.
   */
  {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-bg')
    const ctx = canvas?.getContext('2d')
    if (canvas && ctx) {
      const GAP = 16
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches
      const REACH = 150
      let w = 0, h = 0, faint = '', accent = '', running = false, visible = true, frame = 0
      let t0 = -1
      /** land dots: [x, y] on their own grid (the page grid on desktop, a finer one on phones) */
      let landDots: number[][] = []
      /** Main islands of Indonesia as [lon, lat] rings (Kalimantan and Papua: the Indonesian parts). */
      const ISLANDS: number[][][] = [
        // Sumatra
        [[95.3,5.6],[97.5,5.2],[98.7,3.8],[100.4,2.2],[101.4,1.7],[102.2,1.0],[103.4,0.4],[103.8,-1.0],[104.8,-2.2],[106.0,-3.2],[105.9,-5.8],[105.0,-5.9],[104.0,-5.0],[102.3,-3.9],[100.9,-2.0],[100.4,-0.9],[99.2,0.4],[98.6,1.7],[97.3,2.9],[96.0,4.1],[95.2,5.2]],
        [[105.1,-1.6],[106.1,-1.7],[106.8,-3.0],[106.0,-3.2],[105.6,-2.5]], // Bangka
        [[107.6,-2.6],[108.3,-2.8],[108.2,-3.2],[107.6,-3.2]], // Belitung
        // Java, Madura
        [[105.2,-6.7],[106.0,-5.9],[107.0,-6.0],[108.3,-6.2],[110.4,-6.9],[111.5,-6.6],[112.7,-6.9],[114.4,-7.8],[114.5,-8.7],[113.0,-8.3],[111.0,-8.2],[109.0,-7.7],[107.4,-7.5],[106.4,-7.4],[105.5,-6.9]],
        [[112.7,-7.0],[114.1,-6.9],[113.9,-7.2],[112.8,-7.2]],
        // Bali and Nusa Tenggara
        [[114.4,-8.1],[115.2,-8.1],[115.7,-8.4],[115.2,-8.8],[114.5,-8.4]],
        [[115.9,-8.3],[116.7,-8.3],[116.5,-8.9],[116.0,-8.8]],
        [[116.8,-8.3],[118.2,-8.1],[119.2,-8.4],[118.8,-8.8],[117.2,-9.0]],
        [[119.8,-8.4],[121.5,-8.3],[123.0,-8.1],[122.8,-8.7],[120.5,-8.8]],
        [[119.0,-9.4],[120.2,-9.4],[120.8,-10.2],[119.8,-10.0]],
        [[123.5,-10.2],[124.4,-9.4],[125.1,-9.1],[124.9,-9.5],[124.0,-10.0]],
        // Kalimantan
        [[109.6,2.0],[111.0,1.2],[112.5,1.5],[113.5,1.3],[114.6,2.0],[115.5,3.3],[115.9,4.3],[117.6,4.2],[117.6,3.4],[118.0,2.0],[119.0,1.0],[117.5,0.1],[117.3,-0.5],[116.8,-1.3],[116.2,-1.9],[116.3,-3.0],[116.0,-3.9],[114.6,-4.1],[114.6,-3.4],[113.9,-3.2],[112.6,-3.4],[111.7,-3.0],[110.2,-2.5],[110.0,-1.8],[109.3,0.0],[108.9,0.9]],
        // Sulawesi
        [[119.4,-5.6],[119.6,-3.5],[118.8,-2.8],[119.3,-1.0],[119.8,0.5],[120.1,0.7],[121.0,1.3],[122.8,1.0],[124.4,1.3],[125.2,1.5],[124.9,1.0],[123.5,0.4],[121.5,0.5],[120.6,0.4],[120.3,-0.9],[121.6,-0.9],[123.4,-0.8],[122.6,-1.3],[121.3,-1.6],[121.9,-2.8],[122.9,-4.1],[122.7,-5.4],[121.9,-4.9],[121.4,-4.0],[120.9,-2.7],[120.4,-3.5],[120.4,-5.5]],
        // Maluku: Halmahera, Seram, Buru
        [[127.4,2.0],[128.0,1.0],[128.7,1.2],[128.2,0.3],[128.9,-0.8],[127.6,-0.6],[127.5,0.8]],
        [[128.0,-2.9],[130.0,-2.9],[130.8,-3.8],[128.5,-3.6]],
        [[126.0,-3.1],[127.2,-3.3],[126.9,-3.8],[126.1,-3.7]],
        // Papua
        [[131.0,-1.2],[132.5,-0.4],[134.1,-0.9],[134.0,-2.2],[135.5,-3.3],[137.0,-1.6],[138.9,-1.6],[140.7,-2.5],[141.0,-2.6],[141.0,-9.1],[140.0,-8.1],[138.9,-8.3],[137.6,-5.5],[136.0,-4.6],[134.3,-3.9],[132.8,-4.0],[132.0,-2.9],[133.3,-2.3],[132.0,-2.2],[131.0,-1.5]],
      ]
      const inRing = (x: number, y: number, ring: number[][]) => {
        let inside = false
        for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
          const [xi, yi] = ring[i], [xj, yj] = ring[j]
          if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside
        }
        return inside
      }
      /**
       * The dots that fall on land, for a map fitted across the upper hero. On
       * desktop they sit on the page's 16px grid; below 700px that grid is too
       * coarse to draw islands, so the map gets a finer 7px grid of its own.
       */
      let landGap = GAP
      const buildLand = () => {
        landGap = w < 700 ? 7 : GAP
        landDots = []
        const LON0 = 94.6, LON1 = 141.4, LAT0 = 6.4, LAT1 = -11.2
        const mw = Math.min(w * (w < 700 ? 0.96 : 0.92), 1320)
        const k = mw / (LON1 - LON0)
        const ox = (w - mw) / 2
        const oy = Math.min(h, 900) * (w < 700 ? 0.2 : 0.37) - ((LAT0 - LAT1) * k) / 2
        for (let y = landGap / 2; y < h; y += landGap) {
          for (let x = landGap / 2; x < w; x += landGap) {
            const lon = LON0 + (x - ox) / k
            const lat = LAT0 - (y - oy) / k
            if (lon < LON0 || lon > LON1 || lat > LAT0 || lat < LAT1) continue
            if (ISLANDS.some((ring) => inRing(lon, lat, ring))) landDots.push([x, y])
          }
        }
      }
      /** 0..1: how much of the map a dot at x shows at time s (seconds since the intro began). */
      const mapAt = (s: number, x: number) => {
        if (s < 0 || s > 4.3) return 0
        const reveal = Math.min(1, Math.max(0, (s - 0.15 - (x / w) * 0.8) / 0.35))
        const fade = s < 2.8 ? 1 : Math.max(0, 1 - (s - 2.8) / 1.5)
        const e = reveal * fade
        return e * e * (3 - 2 * e)
      }
      // pointer: target position and presence, and the eased values drawn
      let tx = 0, ty = 0, tOn = 0, px = 0, py = 0, on = 0

      const readColours = () => {
        const cs = getComputedStyle(document.documentElement)
        faint = cs.getPropertyValue('--dots').trim()
        accent = cs.getPropertyValue('--accent').trim()
      }
      const resize = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2)
        w = canvas.clientWidth
        h = canvas.clientHeight
        canvas.width = w * dpr
        canvas.height = h * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        buildLand()
      }
      const draw = (t: number) => {
        ctx.clearRect(0, 0, w, h)
        const s = t / 1000
        const si = t0 < 0 ? -1 : (t - t0) / 1000
        const intro = si >= 0 && si <= 4.3
        for (let y = GAP / 2; y < h; y += GAP) {
          for (let x = GAP / 2; x < w; x += GAP) {
            // two broad, slow waves: one sweeping across, one rippling out from the right
            const v =
              (Math.sin(x * 0.004 + y * 0.003 + s * 0.25) +
                Math.sin(Math.hypot(x - w * 0.75, y - h * 0.35) * 0.008 - s * 0.3)) / 4 + 0.5
            const k = v * v
            const near = on > 0.01 ? Math.max(0, 1 - Math.hypot(x - px, y - py) / REACH) : 0
            const f = near * near * on
            // sea dots step back while the map is up
            const dim = intro ? 1 - 0.7 * mapAt(si, w * 0.5) : 1
            ctx.globalAlpha = Math.min(1, (0.1 + k * 0.45 * (1 - f) + f * 0.85) * dim)
            ctx.fillStyle = f > 0.12 || (v > 0.8 && on < 0.5) ? accent : faint
            ctx.beginPath()
            ctx.arc(x, y, 0.7 + k * 0.9 + f * 1.4, 0, Math.PI * 2)
            ctx.fill()
          }
        }
        // the Indonesia map, over the dimmed grid
        if (intro) {
          const fine = landGap < GAP
          for (const [x, y] of landDots) {
            const m = mapAt(si, x)
            if (m < 0.001) continue
            ctx.globalAlpha = 0.1 + m * 0.85
            ctx.fillStyle = m > 0.3 ? accent : faint
            ctx.beginPath()
            ctx.arc(x, y, (fine ? 0.5 + m * 0.9 : 0.8 + m * 1.2), 0, Math.PI * 2)
            ctx.fill()
          }
        }
      }
      const loop = (t: number) => {
        if (t0 < 0 && !still) {
          t0 = t
          // open the hero's centre mask for the map, close it as the map dissolves
          canvas.classList.add('intro')
          setTimeout(() => canvas.classList.remove('intro'), 2800)
        }
        px += (tx - px) * 0.14
        py += (ty - py) * 0.14
        on += (tOn - on) * 0.08
        draw(t)
        frame = requestAnimationFrame(loop)
      }
      const update = () => {
        const should = visible && !document.hidden && !still
        if (should && !running) { running = true; frame = requestAnimationFrame(loop) }
        if (!should && running) { running = false; cancelAnimationFrame(frame) }
      }

      readColours()
      resize()
      draw(0)
      new ResizeObserver(() => { resize(); draw(performance.now()) }).observe(canvas)
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; update() }).observe(canvas)
      document.addEventListener('visibilitychange', update)
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readColours(); draw(performance.now()) })
      new MutationObserver(() => { readColours(); draw(performance.now()) }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      const hero = canvas.parentElement!
      hero.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect()
        tx = e.clientX - r.left
        ty = e.clientY - r.top
        if (on < 0.01) { px = tx; py = ty }
        tOn = 1
        if (still) { px = tx; py = ty; on = 1; draw(0) }
      })
      hero.addEventListener('pointerleave', () => {
        tOn = 0
        if (still) { on = 0; draw(0) }
      })
      update()
    }
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const NS = 'http://www.w3.org/2000/svg'

  // Two pulses ride each wire, in both the wide and the narrow diagram. A dot
  // stays hidden until its first run starts, so it never sits at the origin.
  for (const group of document.querySelectorAll<SVGGElement>('.hub .pulses')) {
    const svg = group.ownerSVGElement!
    for (const [index, id] of group.dataset.wires!.split(' ').entries()) {
      const out = index >= 4
      for (const offset of [0, 1]) {
        const dot = document.createElementNS(NS, 'circle')
        dot.setAttribute('r', '3.5')
        dot.setAttribute('class', 'pulse' + (out ? ' out' : ''))
        dot.setAttribute('visibility', 'hidden')
        const delay = ((index % 4) * 0.55 + (out ? 1.3 : 0) + offset * 1.3).toFixed(2) + 's'

        const show = document.createElementNS(NS, 'set')
        show.setAttribute('attributeName', 'visibility')
        show.setAttribute('to', 'visible')
        show.setAttribute('begin', delay)

        const motion = document.createElementNS(NS, 'animateMotion')
        motion.setAttribute('dur', '2.6s')
        motion.setAttribute('repeatCount', 'indefinite')
        motion.setAttribute('begin', delay)
        const path = document.createElementNS(NS, 'mpath')
        path.setAttribute('href', '#' + id)
        motion.appendChild(path)
        dot.append(show, motion)
        group.appendChild(dot)
      }
    }
    if (reduce) svg.pauseAnimations()
  }

  // Live readouts on the hub: gateway stats and source values drift, and the
  // alert count ticks up now and then. Runs only while the hero is on screen.
  {
    const vals = Array.from(document.querySelectorAll<SVGTextElement>('.hub [data-hubval]'))
    const alerts = document.querySelector<SVGTextElement>('.hub [data-alerts]')
    const hub = document.querySelector('.hub')
    if (vals.length && hub && !reduce) {
      let n = 2
      let timer = 0
      const tick = () => {
        for (const el of vals) {
          const base = Number(el.dataset.hubval)
          const v = base + (Math.random() - 0.5) * 2 * Number(el.dataset.step)
          const dp = Number(el.dataset.dp)
          el.textContent = v.toLocaleString('en-US', { minimumFractionDigits: dp, maximumFractionDigits: dp }) + (el.dataset.unit ?? '')
        }
        if (alerts && Math.random() < 0.08) alerts.textContent = `${n = n >= 5 ? 1 : n + 1} ${alerts.dataset.alerts}`
      }
      new IntersectionObserver(([e]) => {
        clearInterval(timer)
        if (e.isIntersecting) timer = window.setInterval(tick, 1200)
      }).observe(hub)
    }
  }
</script>
