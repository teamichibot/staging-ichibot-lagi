---
/**
 * Hub diagram geometry is lifted verbatim from the approved draft. The nodes
 * are generated from data rather than eight hand-written SVG groups, so a label
 * or an icon can change in one place.
 *
 * Icons are 16x16 in their own coordinate space and translated into position;
 * each draws the thing the node is, not a generic glyph.
 *
 * The pulse circles are generated client-side because there are 16 of them and
 * they only differ by which path they ride.
 */
const icons = {
  // a controller module with its terminal block
  plc: '<rect x="2" y="3" width="12" height="10" rx="1.5"/><path d="M5.6 3v10"/><path d="M8 6.2h3.6M8 9.8h3.6"/>',
  // a dial reading a physical quantity
  sensor: '<circle cx="8" cy="8" r="5.6"/><path d="M8 8l3-2.4"/><path d="M8 2.4v1.4M13.6 8h-1.4M8 13.6v-1.4M2.4 8h1.4"/>',
  // a video camera
  camera: '<rect x="1.6" y="4.2" width="9.4" height="7.6" rx="1.6"/><path d="M11 7.2l3.4-2.2v6l-3.4-2.2z"/>',
  // a meter with a bolt in it
  meter: '<rect x="2" y="2" width="12" height="12" rx="2"/><path d="M8.8 4.4 6.1 8.4h2l-.7 3.2 2.9-4.2h-2z"/>',
  // a chart on a screen
  dashboard: '<rect x="1.6" y="2.6" width="12.8" height="10.8" rx="1.6"/><path d="M4.8 10.8V8.4M8 10.8V5.6M11.2 10.8V7.6"/>',
  // a database
  erp: '<ellipse cx="8" cy="4" rx="5" ry="2"/><path d="M3 4v8c0 1.1 2.2 2 5 2s5-.9 5-2V4"/><path d="M3 8c0 1.1 2.2 2 5 2s5-.9 5-2"/>',
  // a bell
  alert: '<path d="M4.2 6.8a3.8 3.8 0 0 1 7.6 0c0 2.9 1.1 4 1.1 4H3.1s1.1-1.1 1.1-4z"/><path d="M6.7 13a1.5 1.5 0 0 0 2.6 0"/>',
  // a spark, for something inferred rather than measured
  ai: '<path d="M6.6 2.2 7.8 5.4 11 6.6 7.8 7.8 6.6 11 5.4 7.8 2.2 6.6 5.4 5.4z"/><path d="M11.6 10.2l.7 1.5 1.5.7-1.5.7-.7 1.5-.7-1.5-1.5-.7 1.5-.7z"/>',
}

/** Left column feeds the system; right column is what it feeds. */
const sources = [
  { y: 70, icon: 'plc', title: 'PLC/Controllers', sub: 'Modbus RTU / TCP', short: 'Modbus RTU/TCP' },
  { y: 155, icon: 'sensor', title: 'Sensors', sub: 'Temp, pressure, vibration', short: 'Temp, pressure' },
  { y: 240, icon: 'camera', title: 'IP cameras', sub: 'RTSP video', short: 'RTSP video' },
  { y: 325, icon: 'meter', title: 'Energy meters', sub: 'kWh, power quality', short: 'kWh, quality' },
]

const outputs = [
  { y: 70, icon: 'dashboard', title: 'Dashboard', sub: 'Live KPIs and trends', short: 'KPIs, trends' },
  { y: 155, icon: 'erp', title: 'ERP / MES', sub: 'Automatic data sync', short: 'Auto data sync' },
  { y: 240, icon: 'alert', title: 'Alerts', sub: 'WhatsApp, email, siren', short: 'WhatsApp, email' },
  { y: 325, icon: 'ai', title: 'AI insights', sub: 'Anomalies, detections', short: 'Anomalies' },
]

/**
 * Narrow screens get a vertical version of the same diagram: sources in a 2x2
 * grid on top, the core in the middle, outputs in a 2x2 grid below. Top-row
 * sources and bottom-row outputs wire round the outside edges so no wire
 * crosses a node.
 */
const V = { w: 150, h: 50, cols: [24, 186], srcRows: [36, 98], outRows: [392, 454] }
const vIn = [
  'M24 61 C6 61 6 190 135 210',
  'M336 61 C354 61 354 190 225 210',
  'M99 148 C99 180 160 180 160 210',
  'M261 148 C261 180 200 180 200 210',
]
const vOut = [
  'M160 330 C160 360 99 360 99 392',
  'M200 330 C200 360 261 360 261 392',
  'M135 330 C6 350 6 479 24 479',
  'M225 330 C354 350 354 479 336 479',
]
const vPos = (i: number, rows: number[]) => ({ x: V.cols[i % 2], y: rows[Math.floor(i / 2)] })
---

<section class="hero">
  <canvas class="hero-bg" aria-hidden="true"></canvas>
  <div class="wrap">
    <h1>Intelligent industrial hub</h1>
    <p class="lede">We help Indonesian industries connect every machine with industrial IoT, see what's happening in real time, and act on it, from the shop floor to your ERP.</p>
    <div class="actions">
      <a class="btn primary" href="#contact">Book a site survey</a>
      <a class="btn" href="#products">Explore products</a>
    </div>

    <div class="stage">
      <div class="window hub" role="img" aria-label="Machines, sensors, cameras and meters send data to the Ichibot Smart System, which delivers it to dashboards, ERP, alerts and AI insights">
        <div class="window-bar" aria-hidden="true">
          <span class="lights"><b></b><b></b><b></b></span>
          <span class="win-tab"><svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="5.5" /><circle cx="8" cy="8" r="1.8" /></svg>Data flow<i>×</i></span>
          <span class="win-new">+</span>
        </div>
        <div class="window-toolbar" aria-hidden="true">
          <span class="nav">‹ ›</span>
          <span class="omnibox"><svg viewBox="0 0 16 16"><rect x="4" y="7" width="8" height="6" rx="1.2" /><path d="M5.8 7V5.4a2.2 2.2 0 0 1 4.4 0V7" /></svg>ichibot.local/system/data-flow</span>
        </div>
        <svg id="hubsvg" viewBox="0 0 1000 440">
          <defs>
            <filter id="gl" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="3"/></filter>
          </defs>
          <text class="col" x="120" y="42" text-anchor="middle">Shop floor</text>
          <text class="col" x="500" y="42" text-anchor="middle">On-prem or cloud</text>
          <text class="col" x="880" y="42" text-anchor="middle">Decisions</text>
          <g id="wires">
            <path id="i1" class="wire" d="M215 95 C330 95 330 220 420 220"/>
            <path id="i2" class="wire" d="M215 180 C330 180 330 220 420 220"/>
            <path id="i3" class="wire" d="M215 265 C330 265 330 220 420 220"/>
            <path id="i4" class="wire" d="M215 350 C330 350 330 220 420 220"/>
            <path id="o1" class="wire" d="M580 220 C670 220 670 95 785 95"/>
            <path id="o2" class="wire" d="M580 220 C670 220 670 180 785 180"/>
            <path id="o3" class="wire" d="M580 220 C670 220 670 265 785 265"/>
            <path id="o4" class="wire" d="M580 220 C670 220 670 350 785 350"/>
          </g>
          {sources.map((n) => (
            <g class="node">
              <rect x="25" y={n.y} width="190" height="50" rx="10" />
              <g class="ic" transform={`translate(41 ${n.y + 17})`} set:html={icons[n.icon as keyof typeof icons]} />
              <text x="68" y={n.y + 22}>{n.title}</text>
              <text class="sub" x="68" y={n.y + 38}>{n.sub}</text>
            </g>
          ))}
          <rect class="ring" x="412" y="142" width="176" height="156" rx="20"><animate attributeName="opacity" values=".6;.15;.6" dur="3s" repeatCount="indefinite"/></rect>
          <g class="core"><rect class="bg" x="420" y="150" width="160" height="140" rx="16"/>
            <rect x="436" y="166" width="14" height="14" rx="3" fill="var(--accent)"/>
            <text x="500" y="212" text-anchor="middle">Ichibot</text>
            <text x="500" y="234" text-anchor="middle">Smart System</text>
            <text class="sub" x="500" y="258" text-anchor="middle">Collect, log, run AI</text></g>
          {outputs.map((n) => (
            <g class="node">
              <rect x="785" y={n.y} width="190" height="50" rx="10" />
              <g class="ic" transform={`translate(801 ${n.y + 17})`} set:html={icons[n.icon as keyof typeof icons]} />
              <text x="828" y={n.y + 22}>{n.title}</text>
              <text class="sub" x="828" y={n.y + 38}>{n.sub}</text>
            </g>
          ))}
          <g class="pulses" data-wires="i1 i2 i3 i4 o1 o2 o3 o4"></g>
        </svg>
        <svg id="hubsvg-v" viewBox="0 0 360 536">
          <text class="col" x="180" y="22" text-anchor="middle">Shop floor</text>
          <text class="col" x="180" y="526" text-anchor="middle">Decisions</text>
          <g>
            {vIn.map((d, i) => <path id={`vi${i + 1}`} class="wire" d={d} />)}
            {vOut.map((d, i) => <path id={`vo${i + 1}`} class="wire" d={d} />)}
          </g>
          {[...sources.map((n, i) => ({ n, ...vPos(i, V.srcRows) })), ...outputs.map((n, i) => ({ n, ...vPos(i, V.outRows) }))].map(({ n, x, y }) => (
            <g class="node">
              <rect x={x} y={y} width={V.w} height={V.h} rx="10" />
              <g class="ic" transform={`translate(${x + 12} ${y + 17})`} set:html={icons[n.icon as keyof typeof icons]} />
              <text x={x + 36} y={y + 22}>{n.title}</text>
              <text class="sub" x={x + 36} y={y + 38}>{n.short}</text>
            </g>
          ))}
          <rect class="ring" x="97" y="202" width="166" height="136" rx="20"><animate attributeName="opacity" values=".6;.15;.6" dur="3s" repeatCount="indefinite"/></rect>
          <g class="core"><rect class="bg" x="105" y="210" width="150" height="120" rx="16"/>
            <rect x="119" y="224" width="12" height="12" rx="3" fill="var(--accent)"/>
            <text x="180" y="268" text-anchor="middle">Ichibot</text>
            <text x="180" y="289" text-anchor="middle">Smart System</text>
            <text class="sub" x="180" y="311" text-anchor="middle">Collect, log, run AI</text></g>
          <g class="pulses" data-wires="vi1 vi2 vi3 vi4 vo1 vo2 vo3 vo4"></g>
        </svg>
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Hero background: a fine, even dot matrix with two broad, slow waves of
   * brightness passing through it. The brightest band picks up the accent
   * colour. Dots near the pointer light up and follow it with a little lag;
   * while the pointer is over the hero the wave's accent steps back so the
   * pointer is the one highlight. Colours come from the CSS tokens, so it
   * follows the theme; it pauses off-screen and in hidden tabs. Under
   * prefers-reduced-motion the waves hold still and the pointer highlight
   * snaps to position instead of easing.
   */
  {
    const canvas = document.querySelector<HTMLCanvasElement>('.hero-bg')
    const ctx = canvas?.getContext('2d')
    if (canvas && ctx) {
      const GAP = 16
      const still = matchMedia('(prefers-reduced-motion: reduce)').matches
      const REACH = 150
      let w = 0, h = 0, faint = '', accent = '', running = false, visible = true, frame = 0
      // pointer: target position and presence, and the eased values drawn
      let tx = 0, ty = 0, tOn = 0, px = 0, py = 0, on = 0

      const readColours = () => {
        const cs = getComputedStyle(document.documentElement)
        faint = cs.getPropertyValue('--faint').trim()
        accent = cs.getPropertyValue('--accent').trim()
      }
      const resize = () => {
        const dpr = Math.min(devicePixelRatio || 1, 2)
        w = canvas.clientWidth
        h = canvas.clientHeight
        canvas.width = w * dpr
        canvas.height = h * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }
      const draw = (t: number) => {
        ctx.clearRect(0, 0, w, h)
        const s = t / 1000
        for (let y = GAP / 2; y < h; y += GAP) {
          for (let x = GAP / 2; x < w; x += GAP) {
            // two broad, slow waves: one sweeping across, one rippling out from the right
            const v =
              (Math.sin(x * 0.004 + y * 0.003 + s * 0.25) +
                Math.sin(Math.hypot(x - w * 0.75, y - h * 0.35) * 0.008 - s * 0.3)) / 4 + 0.5
            const k = v * v
            const near = on > 0.01 ? Math.max(0, 1 - Math.hypot(x - px, y - py) / REACH) : 0
            const f = near * near * on
            ctx.globalAlpha = Math.min(1, 0.1 + k * 0.45 * (1 - f) + f * 0.85)
            ctx.fillStyle = f > 0.12 || (v > 0.8 && on < 0.5) ? accent : faint
            ctx.beginPath()
            ctx.arc(x, y, 0.7 + k * 0.9 + f * 1.4, 0, Math.PI * 2)
            ctx.fill()
          }
        }
      }
      const loop = (t: number) => {
        px += (tx - px) * 0.14
        py += (ty - py) * 0.14
        on += (tOn - on) * 0.08
        draw(t)
        frame = requestAnimationFrame(loop)
      }
      const update = () => {
        const should = visible && !document.hidden && !still
        if (should && !running) { running = true; frame = requestAnimationFrame(loop) }
        if (!should && running) { running = false; cancelAnimationFrame(frame) }
      }

      readColours()
      resize()
      draw(0)
      new ResizeObserver(() => { resize(); draw(performance.now()) }).observe(canvas)
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; update() }).observe(canvas)
      document.addEventListener('visibilitychange', update)
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readColours(); draw(performance.now()) })
      new MutationObserver(() => { readColours(); draw(performance.now()) }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })
      const hero = canvas.parentElement!
      hero.addEventListener('pointermove', (e) => {
        const r = canvas.getBoundingClientRect()
        tx = e.clientX - r.left
        ty = e.clientY - r.top
        if (on < 0.01) { px = tx; py = ty }
        tOn = 1
        if (still) { px = tx; py = ty; on = 1; draw(0) }
      })
      hero.addEventListener('pointerleave', () => {
        tOn = 0
        if (still) { on = 0; draw(0) }
      })
      update()
    }
  }

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  const NS = 'http://www.w3.org/2000/svg'

  // Two pulses ride each wire, in both the wide and the narrow diagram. A dot
  // stays hidden until its first run starts, so it never sits at the origin.
  for (const group of document.querySelectorAll<SVGGElement>('.hub .pulses')) {
    const svg = group.ownerSVGElement!
    for (const [index, id] of group.dataset.wires!.split(' ').entries()) {
      const out = index >= 4
      for (const offset of [0, 1]) {
        const dot = document.createElementNS(NS, 'circle')
        dot.setAttribute('r', '3.5')
        dot.setAttribute('class', 'pulse' + (out ? ' out' : ''))
        dot.setAttribute('visibility', 'hidden')
        const delay = ((index % 4) * 0.55 + (out ? 1.3 : 0) + offset * 1.3).toFixed(2) + 's'

        const show = document.createElementNS(NS, 'set')
        show.setAttribute('attributeName', 'visibility')
        show.setAttribute('to', 'visible')
        show.setAttribute('begin', delay)

        const motion = document.createElementNS(NS, 'animateMotion')
        motion.setAttribute('dur', '2.6s')
        motion.setAttribute('repeatCount', 'indefinite')
        motion.setAttribute('begin', delay)
        const path = document.createElementNS(NS, 'mpath')
        path.setAttribute('href', '#' + id)
        motion.appendChild(path)
        dot.append(show, motion)
        group.appendChild(dot)
      }
    }
    if (reduce) svg.pauseAnimations()
  }
</script>
