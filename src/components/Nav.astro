---
/**
 * Site navbar. Desktop: a Products dropdown listing each product (links open
 * that product's tab via #product-<key>), plain section links, and the survey
 * CTA; the link for the section in view is marked. Below 880px the links fold
 * into a menu panel behind a toggle button.
 */
import { productsFor } from '../data/products'
import { productIcons } from '../data/product-icons'
import { basePath, langFromUrl, localize, type Lang } from '../i18n'

const lang = langFromUrl(Astro.url)
const page = basePath(Astro.url.pathname)
const products = productsFor(lang)
const t = {
  en: { products: 'Products', all: 'See all products →', explore: 'Explore products proven in the field', overview: 'See all products', how: 'How it works', cases: 'Case studies', services: 'Services', insights: 'Insights', cta: 'Book a site survey', company: 'Company', open: 'Open menu', close: 'Close menu', home: 'Ichibot home', main: 'Main', language: 'Language' },
  id: { products: 'Produk', all: 'Lihat semua produk →', explore: 'Jelajahi produk yang sudah terbukti di lapangan', overview: 'Lihat semua produk', how: 'Cara kerja', cases: 'Studi kasus', services: 'Layanan', insights: 'Artikel', cta: 'Jadwalkan survei lokasi', company: 'Perusahaan', open: 'Buka menu', close: 'Tutup menu', home: 'Beranda Ichibot', main: 'Utama', language: 'Bahasa' },
}[lang]

// Section anchors live on the homepage; other pages link back to it.
const home = page === '/' ? '' : localize('/', lang)
// The CTA scrolls to the survey section on pages that have one (all but /contact).
const contactHref = page === '/contact' ? '#contact-form' : '#contact'
const blog = localize('/blog', lang)
const links = [
  { href: `${home}#platform`, label: t.how },
  { href: `${home}#cases`, label: t.cases },
  { href: `${home}#services`, label: t.services },
  { href: blog, label: t.insights },
]
// Same page in each language, keeping filters such as ?category=.
const langs: { code: Lang; label: string; name: string }[] = [
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'id', label: 'ID', name: 'Bahasa Indonesia' },
]
const switchHref = (l: Lang) => localize(page, l) + Astro.url.search
---

<header class="nav">
  <div class="wrap">
    <a class="brand" href={localize('/', lang)} aria-label={t.home}><span class="logo" role="img" aria-label="Ichibot"></span></a>

    <nav class="nav-links" aria-label={t.main}>
      <div class="nav-drop">
        <button type="button" class="nav-drop-btn" aria-expanded="false" aria-controls="nav-products" data-section="products">
          {t.products}
          <svg viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" /></svg>
        </button>
        {/* full-width panel that joins the bar: intro and overview link on the
            left, the products on the right */}
        <div class="nav-panel" id="nav-products">
          <div class="wrap nav-panel-inner">
            <div class="nav-panel-intro">
              <p class="nav-panel-title">{t.explore}</p>
              <a class="nav-panel-all" href={`${home}#products`}>{t.overview}</a>
            </div>
            <div class="nav-panel-list">
              <small>{t.products}</small>
              <ul>
                {products.map((p) => (
                  <li>
                    <a href={`${home}#product-${p.key}`}>
                      <span class="nav-ic"><svg viewBox="0 0 16 16" set:html={productIcons[p.key]} /></span>
                      {p.name}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
      {links.map((l) => <a href={l.href} data-section={l.href.split('#')[1]} aria-current={l.href === blog && page.startsWith('/blog') ? 'page' : undefined}>{l.label}</a>)}
    </nav>

    <div class="nav-end">
      <div class="lang-switch" role="group" aria-label={t.language}>
        {langs.map((l) => (
          <a href={switchHref(l.code)} hreflang={l.code} lang={l.code} title={l.name} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a>
        ))}
      </div>
      <a class="btn primary sm nav-cta" href={contactHref}>{t.cta}</a>
      <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-mobile" aria-label={t.open} data-open={t.open} data-close={t.close}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="nav-mobile" id="nav-mobile" hidden>
    <div class="wrap">
      <small>{t.products}</small>
      <ul>
        {products.map((p) => (
          <li>
            <a href={`${home}#product-${p.key}`}>
              <span class="nav-ic"><svg viewBox="0 0 16 16" set:html={productIcons[p.key]} /></span>
              {p.name}
            </a>
          </li>
        ))}
      </ul>
      <small>{t.company}</small>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
      <a class="btn primary" href={contactHref}>{t.cta}</a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('header.nav')!

  // Products dropdown: opens on hover (via CSS) and on click/keyboard (via aria-expanded).
  const drop = header.querySelector<HTMLElement>('.nav-drop')!
  const dropBtn = drop.querySelector<HTMLButtonElement>('.nav-drop-btn')!
  const setDrop = (open: boolean) => dropBtn.setAttribute('aria-expanded', String(open))
  dropBtn.addEventListener('click', () => setDrop(dropBtn.getAttribute('aria-expanded') !== 'true'))
  drop.addEventListener('focusout', (e) => {
    if (!drop.contains(e.relatedTarget as Node)) setDrop(false)
  })
  drop.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    setDrop(false)
    // hover keeps the panel open under the pointer; this closes it after a pick
    drop.classList.add('picked')
  }))
  drop.addEventListener('mouseleave', () => drop.classList.remove('picked'))

  // Mobile menu
  const toggle = header.querySelector<HTMLButtonElement>('.nav-toggle')!
  const mobile = header.querySelector<HTMLElement>('.nav-mobile')!
  const setMobile = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open))
    toggle.setAttribute('aria-label', (open ? toggle.dataset.close : toggle.dataset.open) ?? '')
    mobile.hidden = !open
    header.classList.toggle('menu-open', open)
  }
  toggle.addEventListener('click', () => setMobile(mobile.hidden))
  mobile.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobile(false)))
  matchMedia('(min-width: 881px)').addEventListener('change', (e) => e.matches && setMobile(false))

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return
    if (dropBtn.getAttribute('aria-expanded') === 'true') {
      setDrop(false)
      dropBtn.focus()
    }
    if (!mobile.hidden) {
      setMobile(false)
      toggle.focus()
    }
  })
  document.addEventListener('click', (e) => {
    if (!drop.contains(e.target as Node)) setDrop(false)
  })

  // Shadow once the page scrolls under the bar
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 4)
  window.addEventListener('scroll', onScroll, { passive: true })
  onScroll()

  // Mark the link for the section in view
  const navItems = Array.from(header.querySelectorAll<HTMLElement>('.nav-links [data-section]'))
  const sections = navItems
    .map((el) => document.getElementById(el.dataset.section!))
    .filter((s): s is HTMLElement => !!s)
  const inView = new Set<string>()
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) e.isIntersecting ? inView.add(e.target.id) : inView.delete(e.target.id)
      const current = sections.find((s) => inView.has(s.id))?.id
      for (const el of navItems) {
        if (el.dataset.section === current) el.setAttribute('aria-current', 'true')
        else el.removeAttribute('aria-current')
      }
    },
    // a section counts as current while it crosses a band just under the bar
    { rootMargin: '-80px 0px -60% 0px' },
  )
  sections.forEach((s) => spy.observe(s))
</script>
