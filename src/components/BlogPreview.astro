---
import { getLatestPosts } from '../lib/site-data'

/**
 * The three latest posts from Supabase `blog_posts`, the table the admin blog
 * editor writes to. v2 has no /blog pages yet (phase 3), so cards open the
 * article on the current site. Change BLOG_BASE to '' once /blog/[slug]
 * exists here.
 */
const BLOG_BASE = 'https://www.ichibot.id'
const posts = await getLatestPosts(3)
const fmt = (d: string) =>
  new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
---

{
  posts.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="head-row">
          <h2>Insights and news</h2>
          <a class="btn sm" href={`${BLOG_BASE}/blog`}>All articles</a>
        </div>
        <div class="posts">
          {posts.map((p) => (
            <a class="post" href={`${BLOG_BASE}/blog/${p.slug}`}>
              <div class="thumb">{p.image && <img src={p.image} alt="" loading="lazy" decoding="async" />}</div>
              <small>{[p.category, p.date && fmt(p.date)].filter(Boolean).join(' · ')}</small>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
