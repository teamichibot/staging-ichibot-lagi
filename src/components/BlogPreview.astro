---
import { getLatestPosts } from '../lib/site-data'
import { dateLocale, langFromUrl, localize } from '../i18n'

/** The three latest posts from Supabase `blog_posts`, the table the admin blog editor writes to. */
const lang = langFromUrl(Astro.url)
const blog = localize('/blog', lang)
const posts = await getLatestPosts(3)
const fmt = (d: string) =>
  new Date(d).toLocaleDateString(dateLocale(lang), { day: 'numeric', month: 'short', year: 'numeric' })
---

{
  posts.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap">
        <div class="head-row">
          <h2>{lang === 'id' ? 'Artikel dan berita' : 'Insights and news'}</h2>
          <a class="btn sm" href={blog}>{lang === 'id' ? 'Semua artikel' : 'All articles'}</a>
        </div>
        <div class="posts">
          {posts.map((p) => (
            <a class="post" href={`${blog}/${p.slug}`}>
              <div class="thumb">{p.image && <img src={p.image} alt="" loading="lazy" decoding="async" />}</div>
              <small>{[p.category, p.date && fmt(p.date)].filter(Boolean).join(' · ')}</small>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
