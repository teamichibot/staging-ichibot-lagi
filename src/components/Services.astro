---
import { getServices } from '../lib/content'

/**
 * Icons follow the same 16px stroke language as the product tabs and the hub
 * diagram: line only, accent coloured, no enclosing box. Each one draws the
 * thing the service actually does rather than a generic glyph.
 */
const { services, steps } = await getServices()
---

<section id="services" style="padding-top:0">
  <div class="wrap">
    <h2>Services from survey to support</h2>
    <p class="lede">Need something beyond our products? We build and support it end to end.</p>

    <div class="svc">
      {
        services.map((s) => (
          <div>
            <svg class="svc-ic" viewBox="0 0 16 16" aria-hidden="true" set:html={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))
      }
    </div>

    <div class="how">
      <h3 class="title">How we work</h3>
      <div class="steps">
        {
          steps.map((s) => (
            <div class="step">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
