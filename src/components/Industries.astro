---
const industries = [
  {
    name: 'Oil & gas and energy',
    icon: '<path d="M8 1.6S3 6.6 3 9.9a5 5 0 0 0 10 0C13 6.6 8 1.6 8 1.6z"/>',
  },
  {
    name: 'Automotive manufacturing',
    icon: '<path d="M2 10V8l1.7-3.3A1 1 0 0 1 4.6 4h6.8a1 1 0 0 1 .9.7L14 8v2"/><path d="M2 10h12"/><circle cx="4.9" cy="11.5" r="1.3"/><circle cx="11.1" cy="11.5" r="1.3"/>',
  },
  {
    name: 'Agribusiness and plantation',
    icon: '<path d="M8 15V7"/><path d="M8 9C5 9 3 7 3 4c3 0 5 2 5 5z"/><path d="M8 7c0-3 2-5 5-5 0 3-2 5-5 5z"/>',
  },
  {
    name: 'Printing and publishing',
    icon: '<path d="M4.5 6V2h7v4"/><rect x="1.8" y="6" width="12.4" height="5" rx="1.2"/><path d="M4.5 10.5h7V14h-7z"/>',
  },
  {
    name: 'Port and marine',
    icon: '<circle cx="8" cy="3" r="1.6"/><path d="M8 4.6V14"/><path d="M5.2 6.6h5.6"/><path d="M2.4 9.4A5.6 5.6 0 0 0 8 14a5.6 5.6 0 0 0 5.6-4.6"/>',
  },
  {
    name: 'Salt and mining',
    icon: '<path d="M4.4 2h7.2l2.4 4-6 8-6-8z"/><path d="M1.8 6h12.4"/><path d="M6 6l2 8 2-8"/>',
  },
]
---

<section id="industries">
  <div class="wrap">
    <h2>Industries we serve</h2>
    <div class="ind">
      {
        industries.map((item) => (
          <span class="ind-item">
            <svg viewBox="0 0 16 16" aria-hidden="true" set:html={item.icon} />
            {item.name}
          </span>
        ))
      }
    </div>
  </div>
</section>
