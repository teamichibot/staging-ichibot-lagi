---
import { Image } from 'astro:assets'
import { getCaseStudies } from '../lib/case-studies'
import { getClientLogos } from '../lib/site-data'
import { clientFor, tagFor, tagIcons } from '../lib/case-tags'

/**
 * Cards follow the Insights layout: a rounded photo, then the client's logo
 * and the product or service the project shows, then the title. Three to a view on desktop.
 */
const [studies, logos] = await Promise.all([getCaseStudies(9), getClientLogos()])
const cards = studies.map((s) => {
  const text = `${s.title} ${s.excerpt ?? ''}`
  return { ...s, client: clientFor(s.title, logos), tag: tagFor(text) }
})

/**
 * Sample testimonials, slotted in after every second case study. They are
 * written placeholders, so they are attributed to a role and a sector, never
 * to a named client, and carry a visible Sample badge. Replace with cleared
 * quotes (and drop `sample`) before launch.
 */
const quotes = [
  { quote: 'We finally see what every compressor is doing before it trips, not after the line stops.', name: 'Maintenance Manager', role: 'Automotive manufacturer', sample: true },
  { quote: 'The weighbridge now writes straight into our ERP. Nobody retypes a ticket any more.', name: 'Operations Head', role: 'Agribusiness group', sample: true },
  { quote: 'They clipped sensors onto equipment older than half our team, and it just started reporting.', name: 'Plant Engineer', role: 'State-owned enterprise', sample: true },
  { quote: 'The pilot ran on one line for a month. That was enough to approve the rest of the site.', name: 'Engineering Lead', role: 'Manufacturing plant', sample: true },
]
type Item = { kind: 'case'; c: (typeof cards)[number]; i: number } | { kind: 'quote'; q: (typeof quotes)[number] }
const items: Item[] = []
cards.forEach((c, i) => {
  items.push({ kind: 'case', c, i })
  const q = quotes[Math.floor(i / 2)]
  if (i % 2 === 1 && q && i < cards.length - 1) items.push({ kind: 'quote', q })
})

---

<section id="cases">
  <div class="wrap">
    <div class="head-row">
      <h2>Case studies</h2>
      <div class="head-actions">
        <div class="car-nav" hidden>
          <button type="button" class="car-btn" data-dir="-1" aria-label="Previous case study">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
          </button>
          <button type="button" class="car-btn" data-dir="1" aria-label="Next case study">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </button>
        </div>
        <a class="btn sm" href="/blog?category=Case Study">All projects</a>
      </div>
    </div>

    {
      studies.length === 0 ? (
        <p class="lede">Case studies are temporarily unavailable.</p>
      ) : (
        <div class="carousel" tabindex="0" role="region" aria-label="Case studies">
          {items.map((it) =>
            it.kind === 'quote' ? (
              <figure class="case-quote">
                {it.q.sample && <span class="sample">Sample</span>}
                <blockquote>“{it.q.quote}”</blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true" />
                  <span><b>{it.q.name}</b><small>{it.q.role}</small></span>
                </figcaption>
              </figure>
            ) : (
            <article class="case-card">
              <div class="case-photo">
                <Image src={it.c.image} alt="" width={560} height={350} densities={[1, 2]} loading={it.i < 4 ? 'eager' : 'lazy'} inferSize={false} />
              </div>
              <div class="case-meta">
                {it.c.client && (
                  <img class="case-logo" src={`/client-logo/${encodeURIComponent(it.c.client.id)}`} alt={it.c.client.name} loading="lazy" />
                )}
                {it.c.tag && (
                  <span class="case-tag">
                    <svg viewBox="0 0 16 16" aria-hidden="true" set:html={tagIcons[it.c.tag.icon]} />
                    {it.c.tag.label}
                  </span>
                )}
              </div>
              <h3>{it.c.title}</h3>
            </article>
          )
          )}
        </div>
      )
    }
  </div>
</section>

<script>
  // Prev/next scroll by one card. The buttons only appear once this runs, so
  // without JS the carousel is still a plain scrollable row.
  {
    const track = document.querySelector<HTMLElement>('.carousel')
    const nav = document.querySelector<HTMLElement>('.car-nav')
    if (track && nav) {
      const [prev, next] = Array.from(nav.querySelectorAll<HTMLButtonElement>('.car-btn'))
      const stepSize = () => {
        const card = track.querySelector<HTMLElement>('.case-card, .case-quote')
        return card ? card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth
      }
      const sync = () => {
        prev.disabled = track.scrollLeft <= 2
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2
      }
      for (const b of [prev, next]) {
        b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * stepSize(), behavior: 'smooth' }))
      }
      track.addEventListener('scroll', sync, { passive: true })
      new ResizeObserver(sync).observe(track)
      nav.hidden = false
      sync()
    }
  }
</script>
