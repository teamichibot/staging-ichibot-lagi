---
import { Image } from 'astro:assets'
import { getCaseStudies } from '../lib/case-studies'

const studies = await getCaseStudies(9)

/**
 * Sample quotes so the mosaic can be judged at real text length. They are
 * written, not collected — so they are attributed to a role and a sector
 * rather than to Pertamina, Toyota or Citra Borneo Utama. Putting invented
 * words in a named client's mouth would be a fabricated endorsement from a
 * real company, which is a different thing from a layout placeholder.
 *
 * Replace wholesale once real quotes are cleared, and drop `sample`.
 */
const quotes = [
  {
    quote:
      'The data was on the machines all along. What we did not have was anyone reading it before something broke.',
    name: 'Production Manager',
    role: 'Automotive plant',
    sample: true,
  },
  {
    quote:
      'Nothing was replaced. They clipped sensors onto equipment that had been running since before I joined.',
    name: 'Head of Maintenance',
    role: 'Oil and gas',
    sample: true,
  },
  {
    quote:
      'The survey took a day. We ran the pilot on one line for a month before committing to the rest of the site.',
    name: 'Plant Engineering Lead',
    role: 'Agribusiness group',
    sample: true,
  },
]

/**
 * Interleave quotes into the photo run so the mosaic alternates rather than
 * showing all photos then all quotes. Positions are uneven on purpose — an even
 * every-third rhythm reads as a template.
 */
type Tile =
  | { kind: 'case'; data: (typeof studies)[number]; tall: boolean }
  | { kind: 'quote'; data: (typeof quotes)[number] }

const quoteAfter = new Set([1, 4, 6])
const tiles: Tile[] = []
studies.forEach((study, i) => {
  // vary the crop so columns do not line up into rows
  tiles.push({ kind: 'case', data: study, tall: i % 3 === 1 })
  if (quoteAfter.has(i) && quotes[tiles.filter((t) => t.kind === 'quote').length]) {
    tiles.push({ kind: 'quote', data: quotes[tiles.filter((t) => t.kind === 'quote').length] })
  }
})
---

<section id="cases" style="padding-top:0">
  <div class="wrap">
    <div class="head-row">
      <h2>Case studies</h2>
      <a class="btn sm" href="/blog?category=Case Study">All projects</a>
    </div>

    {
      studies.length === 0 ? (
        <p class="lede">Case studies are temporarily unavailable.</p>
      ) : (
        <div class="mosaic">
          {tiles.map((tile) =>
            tile.kind === 'case' ? (
              <a class="tile-case" href={`/blog/${tile.data.slug}`}>
                <span class={tile.tall ? 'shot tall' : 'shot'}>
                  <Image
                    src={tile.data.image}
                    alt={tile.data.title}
                    width={720}
                    height={tile.tall ? 900 : 540}
                    loading="lazy"
                    inferSize={false}
                  />
                </span>
                <span class="tile-title">{tile.data.title}</span>
              </a>
            ) : (
              <figure class="tile-quote">
                <blockquote>{tile.data.quote}</blockquote>
                <figcaption>
                  <span class="avatar" aria-hidden="true" />
                  <span>
                    <b>{tile.data.name}</b>
                    <small>{tile.data.role}</small>
                  </span>
                  {tile.data.sample && <span class="sample">Sample</span>}
                </figcaption>
              </figure>
            )
          )}
        </div>
      )
    }

    <span class="note">
      Draft: the quotes are written samples, attributed to a role and sector rather
      than to a named client. Replace with cleared client quotes, and add a result
      figure per case where one exists.
    </span>
  </div>
</section>
