---
import { Image } from 'astro:assets'
import { getCaseStudies } from '../lib/case-studies'
import { getClientLogos } from '../lib/site-data'
import { clientFor, tagFor, tagIcons } from '../lib/case-tags'

/**
 * Each card: a colour-graded photo (one treatment for every picture, so a set
 * of site photos taken in different light reads as one series; hover shows the
 * original), then an info panel in the page's own style with the client's
 * logo, the product or service the project shows, the title and one line.
 */
const [studies, logos] = await Promise.all([getCaseStudies(9), getClientLogos()])
const cards = studies.map((s) => {
  const text = `${s.title} ${s.excerpt ?? ''}`
  return { ...s, client: clientFor(s.title, logos), tag: tagFor(text) }
})

---

<section id="cases">
  <div class="wrap">
    <div class="head-row">
      <h2>Case studies</h2>
      <div class="head-actions">
        <div class="car-nav" hidden>
          <button type="button" class="car-btn" data-dir="-1" aria-label="Previous case study">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg>
          </button>
          <button type="button" class="car-btn" data-dir="1" aria-label="Next case study">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg>
          </button>
        </div>
        <a class="btn sm" href="/blog?category=Case Study">All projects</a>
      </div>
    </div>

    {
      studies.length === 0 ? (
        <p class="lede">Case studies are temporarily unavailable.</p>
      ) : (
        <div class="carousel" tabindex="0" role="region" aria-label="Case studies">
          {cards.map((c) => (
            <article class="case-card">
              <div class="case-photo">
                <Image src={c.image} alt="" width={796} height={280} densities={[1, 2]} loading="lazy" inferSize={false} />
              </div>
              <div class="case-info">
                <div class="case-meta">
                  {c.client && (
                    <img class="case-logo" src={c.client.logo} alt={c.client.name} loading="lazy" referrerpolicy="no-referrer" />
                  )}
                  {c.tag && (
                    <span class="case-tag">
                      <svg viewBox="0 0 16 16" aria-hidden="true" set:html={tagIcons[c.tag.icon]} />
                      {c.tag.label}
                    </span>
                  )}
                </div>
                <h3>{c.title}</h3>
                {c.excerpt && <p>{c.excerpt}</p>}
              </div>
            </article>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  // Prev/next scroll by one card. The buttons only appear once this runs, so
  // without JS the carousel is still a plain scrollable row.
  {
    const track = document.querySelector<HTMLElement>('.carousel')
    const nav = document.querySelector<HTMLElement>('.car-nav')
    if (track && nav) {
      const [prev, next] = Array.from(nav.querySelectorAll<HTMLButtonElement>('.car-btn'))
      const stepSize = () => {
        const card = track.querySelector<HTMLElement>('.case-card')
        return card ? card.offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0') : track.clientWidth
      }
      const sync = () => {
        prev.disabled = track.scrollLeft <= 2
        next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2
      }
      for (const b of [prev, next]) {
        b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * stepSize(), behavior: 'smooth' }))
      }
      track.addEventListener('scroll', sync, { passive: true })
      new ResizeObserver(sync).observe(track)
      nav.hidden = false
      sync()
    }
  }
</script>
