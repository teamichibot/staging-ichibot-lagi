---
import { whatsappLinkFor } from '../lib/contact'
import { langFromUrl } from '../i18n'

const lang = langFromUrl(Astro.url)
const t = {
  en: { label: 'Chat with Ichibot on WhatsApp', name: 'Ichibot team', cta: 'Planning a project? Chat with us', close: 'Hide message' },
  id: { label: 'Chat dengan Ichibot di WhatsApp', name: 'Tim Ichibot', cta: 'Ada rencana proyek? Chat kami', close: 'Sembunyikan pesan' },
}[lang]
---

{/*
  Floating WhatsApp button. A few seconds after the first page of a visit it
  slides open into a small card (avatar, name, one-line invitation), then
  folds back into the round button; on devices with a pointer it also opens on
  hover. Opening turns it WhatsApp green; closed, it keeps the site accent.
  The avatar is the customer service portrait Ichibot supplied.
*/}
<div class="wa-dock" data-wa>
  <a class="wa-float" href={whatsappLinkFor(lang)} target="_blank" rel="noopener noreferrer" aria-label={t.label}>
    <span class="wa-msg" aria-hidden="true">
      <span class="wa-msg-in">
        <span class="wa-avatar"><img src="/media/cs/avatar.webp" alt="" width="40" height="40" /></span>
        <span class="wa-text">
          <b>{t.name}</b>
          <span>{t.cta}</span>
        </span>
      </span>
    </span>
    <span class="wa-ic">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.87 9.87 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.24 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29z"
        />
      </svg>
    </span>
  </a>
  <button class="wa-close" type="button" aria-label={t.close} tabindex="-1">
    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 3l6 6M9 3l-6 6" /></svg>
  </button>
</div>

<script>
  const dock = document.querySelector<HTMLElement>('[data-wa]')
  if (dock) {
    const KEY = 'wa-intro'
    let seen = false
    try { seen = sessionStorage.getItem(KEY) === '1' } catch {}
    const mark = () => { try { sessionStorage.setItem(KEY, '1') } catch {} }
    let timer = 0
    const close = () => { dock.classList.remove('open'); clearTimeout(timer) }
    dock.querySelector('.wa-close')?.addEventListener('click', () => { close(); mark() })
    dock.querySelector('.wa-float')?.addEventListener('click', mark)
    if (!seen) {
      setTimeout(() => {
        dock.classList.add('open')
        mark()
        timer = window.setTimeout(close, 8000)
      }, 3500)
    }
  }
</script>
