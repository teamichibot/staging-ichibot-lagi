---
/**
 * Positioning corrected 2026-09-23. The section used to claim every product
 * runs on one shared platform, which is not true — use cases diverge too far
 * for that. What Ichibot actually sells is every layer of the system.
 *
 * Laid out 2026-09-27 as four large rows, copy on the left and a UI mockup on
 * the right, each mockup framed with a soft accent glow. The mockups are
 * built in HTML so they follow the theme; the numbers in them are
 * illustrative, not a client's data. Copy stays plain and descriptive.
 */
import { langFromUrl } from '../i18n'

// Section copy is translated; the UI mockups stay in English, like the
// product dashboards they depict.
const t = {
  en: {
    // One statement sentence, no separate lede.
    title: 'End-to-end industrial IoT, from connecting your machines and sensors to real-time monitoring, data logs and the systems you already use.',
    f1: ['Sensor and data connection', 'Connect PLCs, controllers, power meters, IP cameras and sensors. Every signal becomes a named data point with its source, unit and status.'],
    f2: ['Real-time monitoring dashboard', 'See live values, trends and alarms for each machine and line, on site or from anywhere.'],
    f3: ['Data logging and reports', 'Every reading is stored in a database. Browse the history, and get hourly, daily and monthly recaps ready to export for reports and audits.'],
    f4: ['Integrations: ERP, AI and alerts', 'Put the data to work in other systems: sync records to your ERP or MES, run AI analytics for anomalies and detections, and send notifications by WhatsApp or email.'],
  },
  id: {
    title: 'Industrial IoT dari ujung ke ujung, dari koneksi mesin dan sensor hingga monitoring real-time, log data, dan sistem yang sudah Anda pakai.',
    f1: ['Koneksi sensor dan data', 'Hubungkan PLC, kontroler, power meter, kamera IP, dan sensor. Setiap sinyal menjadi data point bernama lengkap dengan sumber, satuan, dan statusnya.'],
    f2: ['Dashboard monitoring real-time', 'Lihat nilai live, tren, dan alarm untuk setiap mesin dan lini, di lokasi maupun dari mana saja.'],
    f3: ['Pencatatan data dan laporan', 'Setiap pembacaan tersimpan di database. Telusuri riwayatnya, dan dapatkan rekap per jam, harian, dan bulanan yang siap diekspor untuk laporan dan audit.'],
    f4: ['Integrasi: ERP, AI, dan notifikasi', 'Manfaatkan data di sistem lain: sinkronkan catatan ke ERP atau MES, jalankan analisis AI untuk anomali dan deteksi, dan kirim notifikasi lewat WhatsApp atau email.'],
  },
}[langFromUrl(Astro.url)]

const protocols = [
  'Modbus RTU', 'Modbus TCP', 'MQTT', 'OPC UA', 'RS-485', 'Ethernet', 'RTSP', 'REST API',
]

/** 1 — data points, as the connection list shows them */
const points = [
  { name: 'Main panel · Active power', src: 'PM-01 · Modbus TCP · 40001', value: '412.6', unit: 'kW', step: 3.2, state: 'ok' },
  { name: 'Main panel · Power factor', src: 'PM-01 · Modbus TCP · 40011', value: '0.97', unit: '', step: 0.01, state: 'ok' },
  { name: 'Compressor ES300 · Pressure', src: 'PLC-02 · Modbus RTU · 30005', value: '7.2', unit: 'bar', step: 0.05, state: 'ok' },
  { name: 'Compressor ES300 · Temperature', src: 'PLC-02 · Modbus RTU · 30007', value: '82.4', unit: '°C', step: 0.3, state: 'warn' },
  { name: 'Pump P1 · Vibration', src: 'VIB-03 · MQTT · pump/p1/vib', value: '2.1', unit: 'mm/s', step: 0.08, state: 'ok' },
  { name: 'Gate 3 · PPE compliance', src: 'CAM-07 · RTSP · edge model', value: '97', unit: '%', step: 1, state: 'ok' },
  { name: 'Soil node A-12 · Moisture', src: 'LoRa-12 · MQTT · soil/a12', value: '32', unit: '%', step: 0, state: 'stale' },
]

/** 2 — a pressure trend for the dashboard mockup, drawn at build time */
const trend = [6.9, 7.0, 7.1, 6.95, 7.05, 7.2, 7.15, 7.3, 7.25, 7.1, 7.2, 7.35, 7.3, 7.2, 7.25, 7.4, 7.3, 7.2, 7.15, 7.25]
const TW = 520
const TH = 150
const toY = (v: number) => TH - ((v - 6.6) / (7.8 - 6.6)) * TH
const trendLine = trend.map((v, i) => `${((i / (trend.length - 1)) * TW).toFixed(1)},${toY(v).toFixed(1)}`).join(' ')
const limitY = toY(7.6).toFixed(1)

/** 3 — database log rows */
const logRows = [
  ['2026-09-27 09:42:10', 'Compressor ES300 · Temperature', '82.4 °C'],
  ['2026-09-27 09:42:10', 'Compressor ES300 · Pressure', '7.2 bar'],
  ['2026-09-27 09:42:05', 'Main panel · Active power', '412.6 kW'],
  ['2026-09-27 09:42:05', 'Main panel · Power factor', '0.97'],
  ['2026-09-27 09:42:00', 'Pump P1 · Vibration', '2.1 mm/s'],
  ['2026-09-27 09:41:55', 'Main panel · Active power', '409.8 kW'],
  ['2026-09-27 09:41:50', 'Compressor ES300 · Temperature', '81.9 °C'],
]
const recap = [
  ['Energy today', '4,812 kWh'],
  ['Peak load', '1.8 MW'],
  ['Running hours', '21.5 h'],
]
---

<section
  id="platform"
  style="background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)"
>
  <div class="wrap">
    <h2 class="statement">{t.title}</h2>

    <div class="features">
      <article class="feature">
        <div class="feature-copy">
          <h3>{t.f1[0]}</h3>
          <p>{t.f1[1]}</p>
          <div class="chips">{protocols.map((p) => <span>{p}</span>)}</div>
        </div>
        <div class="feature-shot" aria-hidden="true">
          <div class="ui">
            <div class="ui-head">
              <b>Data points</b><span class="count">128 live</span>
              <span class="search">Search tag or device</span>
            </div>
            <ul class="points">
              {points.map((p) => (
                <li>
                  <i class:list={['dot', p.state]} />
                  <span class="pt"><b>{p.name}</b><small>{p.src}</small></span>
                  <span class:list={['val', p.state]}>
                    {p.state === 'stale' ? p.value : <span data-live={p.value} data-step={p.step} data-dp={p.value.split('.')[1]?.length ?? 0}>{p.value}</span>}
                    <small>{p.unit}</small>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <article class="feature">
        <div class="feature-copy">
          <h3>{t.f2[0]}</h3>
          <p>{t.f2[1]}</p>
        </div>
        <div class="feature-shot" aria-hidden="true">
          <div class="ui">
            <div class="ui-head">
              <b>Compressor room · Line 1</b><span class="live">● Live</span>
              <span class="ranges"><em>1H</em><em class="on">24H</em><em>7D</em></span>
            </div>
            <div class="kpis">
              <div><small>Pressure</small><b data-live="7.2" data-step="0.05" data-dp="1">7.2</b><span>bar</span></div>
              <div><small>Temperature</small><b class="warn" data-live="82.4" data-step="0.3" data-dp="1">82.4</b><span>°C</span></div>
              <div><small>Power</small><b data-live="41.8" data-step="0.4" data-dp="1">41.8</b><span>kW</span></div>
            </div>
            <div class="chart">
              <div class="chart-head"><span>Pressure, last 24 hours</span><span>limit 7.6 bar</span></div>
              <svg viewBox={`0 0 ${TW} ${TH}`} preserveAspectRatio="none" data-trend={trend.join(',')} data-w={TW} data-h={TH} data-lo="6.6" data-hi="7.8">
                <defs>
                  <linearGradient id="trend-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="var(--accent)" stop-opacity=".28" />
                    <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <line class="limit" x1="0" x2={TW} y1={limitY} y2={limitY} />
                <polygon fill="url(#trend-fill)" points={`0,${TH} ${trendLine} ${TW},${TH}`} />
                <polyline class="line" points={trendLine} />
              </svg>
              <div class="axis"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>now</span></div>
            </div>
            <div class="alarm"><i class="dot warn" /> High temperature · Compressor ES300 <span>09:42</span></div>
          </div>
        </div>
      </article>

      <article class="feature">
        <div class="feature-copy">
          <h3>{t.f3[0]}</h3>
          <p>{t.f3[1]}</p>
        </div>
        <div class="feature-shot" aria-hidden="true">
          <div class="ui">
            <div class="ui-head">
              <span class="tabs-mini"><em class="on">Log</em><em>Hourly recap</em><em>Daily recap</em></span>
              <span class="export">Export CSV</span>
            </div>
            <div class="recap">
              {recap.map(([label, value], i) => <div><small>{label}</small><b data-recap={i === 0 ? value.replace(/[^0-9]/g, '') : undefined}>{value}</b></div>)}
            </div>
            <table class="log">
              <thead><tr><th>Timestamp</th><th>Data point</th><th>Value</th></tr></thead>
              <tbody data-log>
                {logRows.map(([t, name, value]) => <tr><td>{t}</td><td>{name}</td><td>{value}</td></tr>)}
              </tbody>
            </table>
            <div class="log-foot">Showing 7 of <span data-rows="1284560">1,284,560</span> rows</div>
          </div>
        </div>
      </article>

      <article class="feature">
        <div class="feature-copy">
          <h3>{t.f4[0]}</h3>
          <p>{t.f4[1]}</p>
        </div>
        <div class="feature-shot" aria-hidden="true">
          <div class="ui apps">
            <div class="app">
              <span class="app-ic"><svg viewBox="0 0 16 16"><ellipse cx="8" cy="4" rx="5" ry="2" /><path d="M3 4v8c0 1.1 2.2 2 5 2s5-.9 5-2V4" /><path d="M3 8c0 1.1 2.2 2 5 2s5-.9 5-2" /></svg></span>
              <div class="app-body">
                <small>ERP / MES</small>
                <b>Weighing record synced</b>
                <span data-erp="142">WB-0927-0142 · 28,460 kg · Truck B 9123 KT</span>
              </div>
              <span class="badge ok">Synced <span data-now>09:41</span></span>
            </div>
            <div class="app">
              <span class="app-ic"><svg viewBox="0 0 16 16"><path d="M6.6 2.2 7.8 5.4 11 6.6 7.8 7.8 6.6 11 5.4 7.8 2.2 6.6 5.4 5.4z" /><path d="M11.6 10.2l.7 1.5 1.5.7-1.5.7-.7 1.5-.7-1.5-1.5-.7 1.5-.7z" /></svg></span>
              <div class="app-body">
                <small>AI analytics</small>
                <b>Anomaly detected</b>
                <span>Pump P1 vibration <span data-live="38" data-step="3" data-dp="0">38</span>% above its normal pattern</span>
              </div>
              <span class="badge">Score <span data-live="0.91" data-step="0.02" data-dp="2">0.91</span></span>
            </div>
            <div class="app">
              <span class="app-ic"><svg viewBox="0 0 16 16"><path d="M4.2 6.8a3.8 3.8 0 0 1 7.6 0c0 2.9 1.1 4 1.1 4H3.1s1.1-1.1 1.1-4z" /><path d="M6.7 13a1.5 1.5 0 0 0 2.6 0" /></svg></span>
              <div class="app-body">
                <small>Notification · WhatsApp</small>
                <p class="bubble">⚠ Compressor ES300 temperature <span data-live="82.4" data-step="0.3" data-dp="1">82.4</span> °C, above the 80 °C limit.<time data-now>09:42</time></p>
                <span>Sent to Maintenance team</span>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  /**
   * Keeps the platform mockups live while the section is on screen: data
   * point and KPI values drift, the pressure trend scrolls, new readings are
   * logged at the top of the table (the row count and today's energy climb),
   * weighing records sync to the ERP with the clock, and the AI score moves.
   * Values stay in plausible bands; nothing runs under reduced motion.
   */
  {
    const root = document.getElementById('platform')
    if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)
      const live = Array.from(root.querySelectorAll<HTMLElement>('[data-live]'))
      const fmt = (n: number, dp = 0) => n.toLocaleString('en-US', { minimumFractionDigits: dp, maximumFractionDigits: dp })
      const pad = (n: number) => String(n).padStart(2, '0')
      const hm = (d: Date) => `${pad(d.getHours())}:${pad(d.getMinutes())}`
      const stamp = (d: Date) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${hm(d)}:${pad(d.getSeconds())}`

      // pressure trend: drop the oldest point, add one near the last
      const trendSvg = q<SVGSVGElement>('[data-trend]')
      const trend = trendSvg ? trendSvg.dataset.trend!.split(',').map(Number) : []
      const drawTrend = () => {
        if (!trendSvg) return
        const W = Number(trendSvg.dataset.w), H = Number(trendSvg.dataset.h)
        const lo = Number(trendSvg.dataset.lo), hi = Number(trendSvg.dataset.hi)
        const pts = trend.map((v, i) => `${((i / (trend.length - 1)) * W).toFixed(1)},${(H - ((v - lo) / (hi - lo)) * H).toFixed(1)}`).join(' ')
        trendSvg.querySelector('polyline')!.setAttribute('points', pts)
        trendSvg.querySelector('polygon')!.setAttribute('points', `0,${H} ${pts} ${W},${H}`)
      }

      // log: readings to append, cycling, each drifting around its base
      const feed: [string, number, number, number, string][] = [
        ['Compressor ES300 · Temperature', 82.4, 0.3, 1, '°C'],
        ['Compressor ES300 · Pressure', 7.2, 0.05, 1, 'bar'],
        ['Main panel · Active power', 412.6, 3.2, 1, 'kW'],
        ['Main panel · Power factor', 0.97, 0.01, 2, ''],
        ['Pump P1 · Vibration', 2.1, 0.08, 1, 'mm/s'],
      ]
      let feedAt = 0
      const tbody = q('[data-log]')
      const rowsEl = q('[data-rows]')
      const recapEl = q('[data-recap]')
      let rows = Number(rowsEl?.dataset.rows ?? 0)
      let energy = Number(recapEl?.dataset.recap ?? 0)
      const logReading = () => {
        if (!tbody) return
        const [name, base, step, dp, unit] = feed[feedAt++ % feed.length]
        const v = base + (Math.random() - 0.5) * 2 * step
        const tr = document.createElement('tr')
        tr.className = 'fresh'
        tr.innerHTML = `<td>${stamp(new Date())}</td><td>${name}</td><td>${fmt(v, dp)}${unit ? ' ' + unit : ''}</td>`
        tbody.prepend(tr)
        tbody.lastElementChild?.remove()
        rows += 1
        if (rowsEl) rowsEl.textContent = fmt(rows)
        energy += 1 + Math.round(Math.random() * 2)
        if (recapEl) recapEl.textContent = `${fmt(energy)} kWh`
      }

      // ERP: a new weighing record every few ticks
      const erpEl = q('[data-erp]')
      let record = Number(erpEl?.dataset.erp ?? 0)
      const trucks = ['B 9123 KT', 'KT 8841 AB', 'B 9507 KT', 'KT 8120 CD', 'DA 8315 LM']
      const syncErp = () => {
        if (!erpEl) return
        const d = new Date()
        record += 1
        const kg = 18000 + Math.round(Math.random() * 140) * 100
        erpEl.textContent = `WB-${pad(d.getMonth() + 1)}${pad(d.getDate())}-${String(record).padStart(4, '0')} · ${fmt(kg)} kg · Truck ${trucks[record % trucks.length]}`
      }
      const clocks = Array.from(root.querySelectorAll<HTMLElement>('[data-now]'))

      // Start from now: re-date the rows rendered on the server (a few seconds
      // apart, newest first) and set the clocks, so nothing jumps on the first tick.
      {
        const now = Date.now()
        tbody?.querySelectorAll('tr').forEach((tr, i) => {
          tr.cells[0].textContent = stamp(new Date(now - (i + 1) * 2500))
        })
        for (const c of clocks) c.textContent = hm(new Date(now))
      }

      let n = 0
      const tick = () => {
        for (const el of live) {
          const base = Number(el.dataset.live), step = Number(el.dataset.step)
          if (step) el.textContent = fmt(base + (Math.random() - 0.5) * 2 * step, Number(el.dataset.dp))
        }
        if (trend.length) {
          const last = trend[trend.length - 1]
          trend.shift()
          trend.push(Math.min(7.5, Math.max(6.85, last + (Math.random() - 0.5) * 0.18)))
          drawTrend()
        }
        logReading()
        if (n % 3 === 0) syncErp()
        for (const c of clocks) c.textContent = hm(new Date())
        n += 1
      }

      let timer = 0
      new IntersectionObserver(([e]) => {
        clearInterval(timer)
        if (e.isIntersecting) timer = window.setInterval(tick, 1600)
      }).observe(root)
    }
  }
</script>
