---
/**
 * Positioning corrected 2026-09-23. The section used to claim every product
 * runs on one shared platform, which is not true — use cases diverge too far
 * for that. What Ichibot actually sells is owning the whole chain: getting the
 * data out of the equipment, the edge, storage, the dashboard, the ERP hand-off
 * and the AI on top, either on-premise or in the cloud.
 */
const protocols = [
  'Modbus RTU', 'Modbus TCP', 'MQTT', 'OPC UA', 'RS-485', 'Ethernet', 'RTSP', 'REST API',
]
---

<section
  id="platform"
  style="background:var(--bg2);border-top:1px solid var(--border);border-bottom:1px solid var(--border)"
>
  <div class="wrap">
    <h2>We build the whole chain, not one link in it</h2>
    <p class="lede">
      A weighbridge screen and a soil-moisture screen have almost nothing in common, so
      there is no single dashboard that fits every plant. What is the same every time is
      everything underneath it — and we build all of it.
    </p>

    <div class="bento">
      <div class="tile t-2">
        <h3>Connectivity</h3>
        <p>We read the equipment you already own — PLCs, VFDs, power meters, IP cameras — and retrofit sensors where there is no data to read yet.</p>
        <div class="viz chips">{protocols.map((x) => <span>{x}</span>)}</div>
      </div>

      <div class="tile t-2">
        <h3>Edge and storage</h3>
        <p>The edge device collects and logs on site, so history survives a dropped connection and is there later for audits and reports.</p>
        <div class="viz flow">
          <span>Collect</span><i></i><span class="hl">Log</span><i></i><span>Sync</span>
        </div>
      </div>

      <div class="tile t-2">
        <h3>AI ready</h3>
        <p>Vision models and anomaly detection run on the same box that collects the data, so detection does not wait on a round trip to a server.</p>
        <div class="viz flow">
          <span>Stream</span><i></i><span class="hl">Infer</span><i></i><span>Alert</span>
        </div>
      </div>

      <div class="tile t-3">
        <h3>Dashboards built for the case</h3>
        <p>Not one template stretched to fit. A plantation gets soil and irrigation; a substation gets load, power factor and cost per line.</p>
        <div class="viz">
          <div class="dash-mini">
            <div class="metric"><b>86%</b><small>OEE</small></div>
            <div class="metric"><b>412</b><small>kWh today</small></div>
            <div class="metric"><b>7.2</b><small>bar pressure</small></div>
            <div class="metric"><b>2</b><small>open alerts</small></div>
          </div>
        </div>
      </div>

      <div class="tile t-3">
        <h3>Straight into your ERP</h3>
        <p>Weighing, production, downtime and energy data land in your ERP or MES without anyone retyping them. Running at Citra Borneo Utama.</p>
        <div class="viz flow">
          <span>Weighbridge</span><i></i><span class="hl">Edge</span><i></i><span>ERP</span>
        </div>
      </div>

      <div class="tile t-6">
        <h3>On-premise or cloud, across the whole chain</h3>
        <p>The same stack runs either way, so the decision is your IT policy's to make rather than ours.</p>
        <div class="viz">
          <div class="seg" role="group" aria-label="Deployment option">
            <button type="button" aria-pressed="true" data-dep="onprem">On-prem</button>
            <button type="button" aria-pressed="false" data-dep="cloud">Cloud</button>
            <button type="button" aria-pressed="false" data-dep="hybrid">Hybrid</button>
          </div>
          <p class="dep-out" id="depout"></p>
        </div>
      </div>
    </div>

    <span class="note">
      Draft: re-check the protocol list against what the edge computer supports at launch.
    </span>
  </div>
</section>

<script>
  const copy: Record<string, string> = {
    onprem:
      'Data stays inside your plant network. Dashboards run on a local server or the edge itself. Best for strict IT and security policies.',
    cloud:
      'The edge publishes to the cloud, so managers can open dashboards from anywhere with no server to maintain.',
    hybrid:
      'Operators use the local dashboard on site, while summaries sync to the cloud for management and multi-site views.',
  }
  const output = document.getElementById('depout')
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-dep]'))
  if (output && buttons.length) {
    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === button))
        output.textContent = copy[button.dataset.dep!] ?? ''
      })
    }
    output.textContent = copy.onprem
  }
</script>
