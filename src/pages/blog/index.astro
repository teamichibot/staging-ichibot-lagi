---
/**
 * All posts. Category (`?category=`, the old site's parameter, so its links
 * keep working), search (`?q=`) and page (`?page=`) are read on the server,
 * so filtering works without JavaScript and every filtered view has a URL.
 */
import PageLayout from '../../layouts/PageLayout.astro'
import PostImage from '../../components/PostImage.astro'
import { FALLBACK_IMAGE, formatDate, getAllPosts } from '../../lib/blog'

const PAGE_SIZE = 30

const params = Astro.url.searchParams
const category = params.get('category') ?? ''
const q = (params.get('q') ?? '').trim()
const all = await getAllPosts()

// Categories by how many posts they hold, so the busy ones come first.
const counts = new Map<string, number>()
for (const p of all) if (p.category) counts.set(p.category, (counts.get(p.category) ?? 0) + 1)
const categories = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))

const needle = q.toLowerCase()
const filtered = all.filter(
  (p) =>
    (!category || p.category === category) &&
    (!needle || p.title.toLowerCase().includes(needle) || p.excerpt.toLowerCase().includes(needle)),
)

const pages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE))
const page = Math.min(pages, Math.max(1, Number.parseInt(params.get('page') ?? '1', 10) || 1))
const shown = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)

const href = (next: { category?: string; q?: string; page?: number }) => {
  const u = new URLSearchParams()
  const c = next.category ?? category
  const s = next.q ?? q
  if (c) u.set('category', c)
  if (s) u.set('q', s)
  if (next.page && next.page > 1) u.set('page', String(next.page))
  const qs = u.toString()
  return qs ? `/blog?${qs}` : '/blog'
}

const title = category ? `${category} — Ichibot Insights` : 'Insights and news — Ichibot'
---

<PageLayout
  title={title}
  description="Articles on industrial IoT, AI and plant digitalisation from the Ichibot team."
>
  <section class="page-head">
    <div class="wrap">
      <h1>Insights and news</h1>
      <p class="lede">Articles on industrial IoT, AI and plant digitalisation from the Ichibot team.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <form class="blog-search" action="/blog" method="get" role="search">
        {category && <input type="hidden" name="category" value={category} />}
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" /><path d="m13 13 4 4" /></svg>
        <input type="search" name="q" value={q} placeholder="Search articles" aria-label="Search articles" />
      </form>

      <nav class="cat-chips" aria-label="Categories">
        <a class="cat-chip" href={href({ category: '' })} aria-current={category ? undefined : 'page'}>
          All <span>{all.length}</span>
        </a>
        {categories.map(([c, n]) => (
          <a class="cat-chip" href={href({ category: c })} aria-current={c === category ? 'page' : undefined}>
            {c} <span>{n}</span>
          </a>
        ))}
      </nav>

      {(category || q) && (
        <p class="blog-meta">
          {filtered.length} {filtered.length === 1 ? 'article' : 'articles'}
          {category && <> in <b>{category}</b></>}
          {q && <> matching <b>“{q}”</b></>}
          <a href="/blog">Clear filters</a>
        </p>
      )}

      {shown.length === 0 ? (
        <div class="empty">
          <p>No articles found.</p>
          <small>Try another keyword or category.</small>
        </div>
      ) : (
        <div class="posts blog-grid">
          {shown.map((p) => (
            <a class="post" href={`/blog/${p.slug}`}>
              <div class="thumb"><PostImage src={p.image || FALLBACK_IMAGE} width={400} height={250} /></div>
              <small>{[p.category, formatDate(p.date)].filter(Boolean).join(' · ')}</small>
              <h3>{p.title}</h3>
              {p.excerpt && <p class="post-excerpt">{p.excerpt}</p>}
            </a>
          ))}
        </div>
      )}

      {pages > 1 && (
        <nav class="pager" aria-label="Pages">
          {page > 1 ? <a class="btn sm" href={href({ page: page - 1 })} rel="prev">← Newer</a> : <span />}
          <span class="pager-pos">Page {page} of {pages}</span>
          {page < pages ? <a class="btn sm" href={href({ page: page + 1 })} rel="next">Older →</a> : <span />}
        </nav>
      )}
    </div>
  </section>
</PageLayout>
