---
/**
 * Not found. Old-site URLs that were deliberately dropped in the rebuild
 * (the 12 former /produk pages, /layanan) land here, so the page points at
 * where that content lives now.
 */
import PageLayout from '../layouts/PageLayout.astro'
---

<PageLayout title="Page not found — Ichibot" description="The page you are looking for does not exist." cta={false}>
  <section class="page-head not-found">
    <div class="wrap">
      <p class="nf-code">404</p>
      <h1>This page does not exist</h1>
      <p class="lede">It may have moved when we rebuilt the site. Products and services are now on the homepage, and every article is under Insights.</p>
      <div class="actions">
        <a class="btn primary" href="/#products">Our products</a>
        <a class="btn" href="/blog">Insights</a>
        <a class="btn" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</PageLayout>
