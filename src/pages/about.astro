---
/**
 * About Ichibot. Copy is the old site's /about (Bahasa Indonesia) in English,
 * with no new claims added. The team comes from `site_data.team`, managed in
 * the admin; the old site's built-in team list was placeholder people, so
 * there is no fallback and the section is hidden when the admin has none.
 */
import PageLayout from '../layouts/PageLayout.astro'
import { readSiteData } from '../lib/site-data'

type TeamMember = { name: string; role: string; bio: string; image: string }
const team = (await readSiteData<TeamMember[]>('team', [])).filter((m) => m.name)

const stats = [
  { value: '4,000+', label: 'Engineers and innovators' },
  { value: '1,500+', label: 'Components in Ichibot Store' },
  { value: '~10', label: 'Years of experience' },
  { value: '50+', label: 'Enterprise clients' },
]

const milestones = [
  {
    year: '2016',
    title: 'Born in the competition arena',
    desc: 'Ichibot was founded in Yogyakarta by Angga Priyatmoko and a group of young engineers. Our engineering was forged in high-level robotics competitions, which demand precise hardware, reliable real-time systems and optimisation down to the component. That discipline is still how we work.',
  },
  {
    year: '2019',
    title: 'From lab to company',
    desc: 'Ichibot joined the Amikom Business Park (ABP) incubator and grew from a research team into a structured technology company, moving from hardware engineering into IoT and AI integration for industry.',
  },
  {
    year: '2021',
    title: 'Asia Hardware Battle',
    desc: 'Recognition at Asia Hardware Battle confirmed Ichibot’s engineering on a regional stage and validated its industrial IoT and AI work as ready to compete at Asian level.',
  },
  {
    year: '2022',
    title: 'Toyota and Pertamina',
    desc: 'Partnerships with Pertamina and Toyota established Ichibot as a domestic technology partner trusted with large-scale work. Real-time IoT monitoring on a Toyota production line became the flagship project that proved the platform.',
  },
  {
    year: 'Today',
    title: 'A national ecosystem',
    desc: 'The Ichibot ecosystem now spans an active community of more than 4,000 engineers and innovators, and Ichibot Store with 1,500+ electronic components and sensors for research and development.',
  },
]

const why = [
  {
    title: 'Full stack, from silicon to cloud',
    desc: 'We work from firmware and non-standard communication protocols up to the cloud platform. When what a project needs is not on the market, our team builds it in-house, with no dependence on outside vendors.',
  },
  {
    title: 'End-to-end solutions plus enablement',
    desc: 'Every engagement covers an end-to-end AI-IoT solution, training so the client’s own team can run it, and access to the engineer and component ecosystem we have built over almost a decade.',
  },
  {
    title: 'An ecosystem of 4,000+ engineers',
    desc: 'An active community that is both our talent pipeline and a contribution to Indonesia’s technological independence, backed by Ichibot Store and its 1,500+ components.',
  },
  {
    title: 'Proven at enterprise scale',
    desc: 'Toyota, Pertamina, BCA and other Indonesian enterprises run our systems in demanding production environments.',
  },
]
---

<PageLayout
  title="About — Ichibot"
  description="Ichibot helps Indonesian manufacturers, energy companies and institutions turn operational data into decisions with industrial IoT and AI. Founded in Yogyakarta in 2016."
>
  <section class="page-head">
    <div class="wrap">
      <h1>AI and IoT for Indonesian industry</h1>
      <p class="lede">We help manufacturers, energy and transport companies and government institutions turn operational data into decisions, with modular technology that is ready for production.</p>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <dl class="stats">
        {stats.map((s) => (
          <div><dt>{s.label}</dt><dd>{s.value}</dd></div>
        ))}
      </dl>

      <div class="about-story">
        <h2>Meaningful change, not a generic solution</h2>
        <div>
          <p>Ichibot exists because of one conviction: Industry 4.0 does not come from generic solutions bought off the shelf. Real change needs deep technical support, adaptation to how each client actually operates, and a thorough transfer of knowledge.</p>
          <p>That is why every engagement includes three things: an end-to-end industrial AI-IoT solution, enablement for the client’s internal team to maintain and extend the system themselves, and access to the engineering ecosystem we have built over almost a decade.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <h2>Almost a decade of building</h2>
      <p class="lede">From the robotics arena to a national industrial AI-IoT platform.</p>
      <ol class="timeline">
        {milestones.map((m) => (
          <li>
            <span class="timeline-year">{m.year}</span>
            <div>
              <h3>{m.title}</h3>
              <p>{m.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="page-body">
    <div class="wrap">
      <h2>Why work with Ichibot</h2>
      <div class="why-grid">
        {why.map((w) => (
          <div>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {team.length > 0 && (
    <section class="page-body">
      <div class="wrap">
        <h2>The people behind Ichibot</h2>
        <ul class="team">
          {team.map((m) => (
            <li>
              {m.image && <img src={m.image} alt="" loading="lazy" decoding="async" />}
              <h3>{m.name}</h3>
              <small>{m.role}</small>
              {m.bio && <p lang="id">{m.bio}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
</PageLayout>
