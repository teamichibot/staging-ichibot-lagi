---
/**
 * One article, in either language. The article itself is in Bahasa
 * Indonesia either way; only the page around it is translated. The route
 * files look the post up (and 404 when it is missing) and pass it in.
 */
import PageLayout from '../layouts/PageLayout.astro'
import { FALLBACK_IMAGE, formatDate, getAllPosts, type Post } from '../lib/blog'
import { renderMarkdown, videoEmbed } from '../lib/markdown'
import PostImage from '../components/PostImage.astro'
import { langFromUrl, localize } from '../i18n'
import { tagFor } from '../lib/case-tags'
import { productsFor } from '../data/products'
import { productIcons } from '../data/product-icons'

interface Props {
  post: Post
}

const { post } = Astro.props
const lang = langFromUrl(Astro.url)
const blog = localize('/blog', lang)

// A case study links to the product it demonstrates (found the way the
// homepage's case cards tag it), so readers can go from proof to product.
const isCase = ['Case Study', 'Studi Kasus'].includes(post.category)
const tag = isCase ? tagFor(`${post.title} ${post.excerpt}`) : undefined
const productKey = tag && ({ integration: 'custom' } as Record<string, string>)[tag.icon] || tag?.icon
const relatedProduct = productKey ? productsFor(lang).find((p) => p.key === productKey) : undefined
const t = {
  en: { back: '← All articles', video: 'Related video', more: 'More articles', all: 'All articles', product: 'Related product', see: 'See the product →' },
  id: { back: '← Semua artikel', video: 'Video terkait', more: 'Artikel lainnya', all: 'Semua artikel', product: 'Produk terkait', see: 'Lihat produknya →' },
}[lang]

const html = renderMarkdown(post.content)
const video = post.videoUrl ? videoEmbed(post.videoUrl) : null

// Three more posts, same category first.
const others = (await getAllPosts()).filter((p) => p.slug !== post.slug)
const related = [
  ...others.filter((p) => p.category === post.category),
  ...others.filter((p) => p.category !== post.category),
].slice(0, 3)

const url = new URL(`/blog/${post.slug}`, Astro.site).href
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date || undefined,
  image: post.image || undefined,
  url,
  mainEntityOfPage: url,
  inLanguage: 'id',
  author: { '@type': 'Organization', name: 'Ichibot' },
  publisher: { '@type': 'Organization', name: 'PT Gagas Anagata Semesta (Ichibot)', url: 'https://www.ichibot.id' },
}
---

<PageLayout
  title={`${post.title} — Ichibot`}
  description={post.excerpt || post.title}
  image={post.image || undefined}
  type="article"
  breadcrumbs={[{ name: lang === 'id' ? 'Artikel' : 'Insights', path: blog }, { name: post.title, path: `${blog}/${post.slug}` }]}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <article lang="id">
    <header class="page-head article-head">
      <div class="wrap narrow">
        <a class="back" href={blog}>{t.back}</a>
        <p class="article-meta">
          {post.category && <a href={`${blog}?category=${encodeURIComponent(post.category)}`}>{post.category}</a>}
          {post.date && <time datetime={post.date}>{formatDate(post.date, lang)}</time>}
        </p>
        <h1>{post.title}</h1>
        {post.excerpt && <p class="lede">{post.excerpt}</p>}
      </div>
    </header>

    {post.image && (
      <div class="wrap">
        <PostImage class="article-cover" src={post.image} width={1100} height={550} eager />
      </div>
    )}

    <div class="wrap narrow">
      <div class="prose" set:html={html} />

      {video && (
        <div class="article-video">
          <h2>{t.video}</h2>
          <div class:list={['embed', { portrait: video.portrait }]}>
            <iframe src={video.src} title={`Video: ${post.title}`} loading="lazy" allow="encrypted-media; picture-in-picture; fullscreen" allowfullscreen />
          </div>
        </div>
      )}

      {relatedProduct && (
        <a class="related-product" href={localize(`/products/${relatedProduct.slug}`, lang)} lang={lang}>
          <span class="nav-ic"><svg viewBox="0 0 16 16" set:html={productIcons[relatedProduct.key]} /></span>
          <span>
            <small>{t.product}</small>
            <b>{relatedProduct.name}</b>
            <em>{relatedProduct.desc}</em>
          </span>
          <span class="related-product-go">{t.see}</span>
        </a>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="related">
      <div class="wrap">
        <div class="head-row">
          <h2>{t.more}</h2>
          <a class="btn sm" href={blog}>{t.all}</a>
        </div>
        <div class="posts">
          {related.map((p) => (
            <a class="post" href={`${blog}/${p.slug}`}>
              <div class="thumb"><PostImage src={p.image || FALLBACK_IMAGE} width={400} height={250} /></div>
              <small>{[p.category, formatDate(p.date, lang)].filter(Boolean).join(' · ')}</small>
              <h3>{p.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>
