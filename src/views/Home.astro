---
/** The homepage, in either language (the language comes from the URL). */
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Hero from '../components/Hero.astro'
import Logos from '../components/Logos.astro'
import Products from '../components/Products.astro'
import Platform from '../components/Platform.astro'
import Cases from '../components/Cases.astro'
import Services from '../components/Services.astro'
import BlogPreview from '../components/BlogPreview.astro'
import Faq from '../components/Faq.astro'
import Cta from '../components/Cta.astro'
import Footer from '../components/Footer.astro'
import { langFromUrl } from '../i18n'

const meta = {
  en: {
    title: 'Ichibot — Intelligent industrial hub | Industrial IoT and AI',
    // Kept to 160 characters so search results show it whole.
    description: 'Industrial IoT and AI for Indonesian plants. Ichibot connects every machine to real-time data, from the shop floor to your ERP. Running at Pertamina and Toyota.',
  },
  id: {
    title: 'Ichibot — Intelligent industrial hub | Industrial IoT dan AI',
    description: 'IoT industri dan AI untuk pabrik Indonesia: Ichibot menghubungkan setiap mesin ke data real-time, dari lantai produksi hingga ERP. Dipakai Pertamina dan Toyota.',
  },
}[langFromUrl(Astro.url)]
---

<BaseLayout title={meta.title} description={meta.description}>
  <Nav />
  <main id="main" tabindex="-1">
    <Hero />
    <Logos />
    <Products />
    <Platform />
    <Cases />
    <Services />
    <BlogPreview />
    <Faq />
    <Cta />
  </main>
  <Footer />
</BaseLayout>
